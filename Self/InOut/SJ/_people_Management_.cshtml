					</gt-no-name></el-tag>
					<div>
						<el-button type="primary" size="mini" @@click="api_AddUser">{{i18n.登入使用者}}</el-button>
						<el-button type="warning" size="mini" @@click="init_curUser(true)">{{i18n.清除重新輸入}}</el-button>
					</div>
