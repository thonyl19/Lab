			</div>

			<gt-err-tag v-model="c_Total" msg="@RES.BLL.Message.SetsuccessfullyNo" sid="sj-people-management.Total"></gt-err-tag>
			<div class="col-lg-12 col-md-12">
			${_sj_tpl.table}
