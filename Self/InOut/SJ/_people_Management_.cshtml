					<div class="clearfix hidden-xs"></div>
				</div>
            </template>
			<el-table :data="c_ListEqp" key="SID"
								empty-text=" "
								style="width: 100%">
							<el-table-column prop="No" label="i18n.機台資訊" width="160">
								<template slot-scope="scope">
									<gt-no-name v-model="scope.row.Display" :no="scope.row.No" :inline="false"></gt-no-name>
								</template>
							</el-table-column>
							<el-table-column  label="i18n.良品數">
								<template slot-scope="scope">
									<el-input-number :span="12" :precision="c_systemConfig.DecimalPoint" :step="c_systemConfig.setp" v-model.number="scope.row.INum" size="large" min="0" required
				></el-input-number>
								</template>
							</el-table-column>
							<el-table-column  label="i18n.良品數">
								<template slot-scope="scope">

								</template>
							</el-table-column>

				</el-table>
			</gti-rwd-layout>
			`,
            dialog_body: `
	 		<el-row :gutter="12">{{curUser}}
				<div v-for="(item,key) in set_model.send_data">
					<el-col :md="24" :lg="item.col" class="wipDynDiv">
						<component :is="item.is"
									v-model="item.model"
									:cfg="item.cfg"
									:ref="item.ref"
									:set_model="set_model"
									v-if="item.isByUser"
									>
							<template v-slot:head-area>
							</template>
						</component>
					</el-col>
				</div>
				<div class="clearfix hidden-xs"></div>
			</el-row>
			`,
		}

        Vue.component('sj-people-management', {
			mixins: [Vue.prototype.$UT.Mixins.v_model()],
            props: {
                "max_count": {
                    type: Number,
                    default: null
                },
                "set_model": {
                    type: Object,
                    default: []
                },
				cfg: Vue.prototype.$PropDef.Array(),
				test: {
                    type: Boolean,
                    default: false
                },
            },
            data() {
                return {
					curUser: '',
					ShowUserForm: false,
					form_cf: {
                        USER_NO: '',
						USER_PW: '',
						row: {},
						idx:'',
					},
					curUser_idx:-1,
					TotalFinishQty: 0,
                    TotalScrapQty:0,
					dialogVisible:false,
                    selected_Shiftitem: "",
                    selected_item: "",
                    userSelected: [],
                    table_list: [],
                    //test: [
                    //    {
                    //        "RefKey": null,
                    //        "SID": "ca009140-44ab-4595-b627-b976801a2c90",
                    //        "No": "UserAdmin",
                    //        "Value": null,
                    //        "Display": "系統管理人員",
                    //        "StatusSid": null,
                    //        "Status": null,
                    //        "FromNum": 0,
                    //        "INum": 0,
                    //        "Attr01": "UserAdmin",
                    //        "Attr02": null,
                    //        "Attr03": null,
                    //        "Attr04": "2024/01/01 12:59:59",
                    //        "Attr05": null,
                    //    },
                    //    {
                    //        "RefKey": null,
                    //        "SID": "GTI24072815180795288",
                    //        "No": "TA20240101",
                    //        "Value": null,
                    //        "Display": "紀穀枝",
                    //        "StatusSid": null,
                    //        "Status": null,
                    //        "FromNum": 0,
                    //        "INum": 0,
                    //        "Attr01": "TA20240101",
                    //        "Attr02": null,
                    //        "Attr03": null,
                    //        "Attr04": "2024/01/01 12:59:59",
                    //        "Attr05": "2024/01/01 12:59:59",
                    //    }
                    //],
                    Total: 0,
					ddl_eqp: {
						val: '',
                        //list: [{ "RefKey": null, "SID": "GTI24072816351496353", "No": "CUT-001", "Value": null, "Display": "切割機001", "StatusSid": null, "Status": null, "FromNum": 0, "INum": 0, "Attr01": null, "Attr02": null, "Attr03": null }],
						rows:[],
                    },
                    selectize_ops: {
                        valueField: 'No',
                        searchField: ['Display', 'No'],
                        tagField: 'No',
                    },
                    selectize_opsCust: {
                        tagField: 'Attr01',
                        valueField: 'No',
                        searchField: ['Display', 'Attr01'],
                    },
					i18n: {
                        placeholder_User: "請掃入人員代碼或關鍵字",
                        placeholder_Eqp:"請掃入設備代碼或關鍵字",
						報工: '報工',
						支援人數: 'RES.BLL.Face.NumberOfSupporters',
						完工總數量: 'RES.BLL.Face.TotalFinishQty',
						完工良品總數: 'RES.BLL.Face.TheTotalNumberOfFinishedProducts',
						報廢總數量: 'RES.BLL.Face.TotalScrapQty2',
						登入使用者: '登入使用者',
						清除重新輸入: '清除重新輸入',
						請確認是否清除: '請確認是否清除',
                        SaveSuccessful:'@RES.BLL.Message.SaveSuccessful',
                    },
					ddl_user:{
						rows:[]
					},
                    isChange:false,
                }
            },
            mounted() {
				this.f_取得預設進站人員資料();
            },
			computed: {
				c_ListEqp: {
					get() {
						let { subItem } = this.curUser;
						return subItem || [];
					},
					set(val) {
                        this.$set(this.curUser, 'subItem', val);
					}
				},
                c_EqpDisplay() {
				    let { EqumentSelectList } = this.set_model;
                    return EqumentSelectList != null && EqumentSelectList.length != 0;
                },
                c_isChange() {
                    return this.isChange ? 'is-change' : '';
                },
				c_systemConfig(){
					let {systemConfig} = this.set_model;
					systemConfig = systemConfig
						||{
							DecimalPoint:0,
							setp:0,
						};
					return systemConfig;
				},
				c_Total(){
					return  this.Total==0;
				},
				c_defectList: {
					get() {
                        var _d = _.get(this.set_model.send_data, `defectList.model`,[]);
						if (_d.length != 0) this.isChange = true;
						return _d;
					},
					set(val) {
                        this.$set(this.set_model.send_data.defectList, 'model', val);
					}
				},
                c_scrapList: {
                    get() {
                        var _d = _.get(this.set_model.send_data, `scrapList.model`, []);
                        if (_d.length != 0) this.isChange = true;
                        return _d;
                    },
                    set(val) {
                        this.$set(this.set_model.send_data.scrapList,'model', val);
                    }
				},
                c_GoodQty: {
					get() {
						//debugger
                        var _d = _.get(this.set_model.send_data.GoodComponent.model, `LotGoodQty`, 0);
                        if (_d > 0) this.isChange = true;
                        return _d;
                    },
                    set(val) {
                        this.$set(this.set_model.send_data.GoodComponent.model,'LotGoodQty', val);
                    }
				},
				c_dialog:{
					get(){return this.dialogVisible;},
					set(val) {
						var _self = this;

						if (val == false && this.isChange) {
							var confirm_arg = { type: 'warning' };
							var confirm_msg = "如果取消,畫面上未儲存的資料將會清空,請確認.";
							_self.$confirm(confirm_msg, '提示', confirm_arg)
								.then(() => {
                                    this.set_cwin(false);
								}).catch(() => {

								});
						} else {
							this.set_cwin(val);
						}
					}
				},
				c_User(){
					let {No,Display,Attr01} = this.curUser ||{};
					return `(${No})${Display} - ${Attr01}`;
				},
                "table_list": {
                    get() {
                        return this.value;
                    },
                    set(val) {
                        this.Total = this.table_list.length;
                        this.$emit('input', val);
                    }
                },
                title() {
                    let { title = "人員報工" } = this.cfg;
                    return title;
				},
				c_user_readonly() {
                    return this.c_ListEqp.length != 0;
				}
            },
			watch: {
				selected_Shiftitem: function (newVal, oldVal) {
					var _self = this;
					let state = _self.$store.state;

					var item = _self.$refs.selectShiftItem.getSelectedRow();
					state.globalvar.UserShift = item[0];
					//let control = controlScope.$refs.Select_User.sel;

				},
                table_list: function (newValue, oldValue) {
                    var _self = this;
                    _self.Total = _self.table_list.length;
                    _self.$emit('input', newValue);

                },
				selected_item: function (newValue, oldValue) {
					if (newValue == "") return ;
                    var _self = this;
                    var checkLists = _self.table_list;
					var [user_0] = _self.ddl_user.rows;
					//user_0;
					for(var idx = 0 ; idx <checkLists.length ; idx++){
						var item = checkLists[idx];
						var is人員己存在 = item.No == newValue;
                        if (is人員己存在) {
							_self.curUser_idx = idx;
                            user_0 = _.cloneDeep(item);
						}
					}
                    let { Attr04: 開始作業, Attr02: 結束作業 } = user_0;
                    var is作業中 = 開始作業 != null && 結束作業 == null;
					if (is作業中) {
						$.showMessageFire({ type: 'error' }, '人員已存在,尚未完成報工');
						_self.selected_item = '';
                        _self.$refs.selectItem.sel.clear();
						return;
					}

					_self.curUser = user_0;
					_self.c_ListEqp = [];
                    var is沒有設備 = _self.c_EqpDisplay == false;
					if (is沒有設備)  _self.api_AddUser();
				},
                'ddl_eqp.val'(newValue, oldValue) {
                    if (newValue == "") return;
                    //debugger
                    var _self = this;
                    var _支援人員記錄表 = _self.table_list;
                    var [ItemInfo] = _self.ddl_eqp.rows;
					let { No } = ItemInfo;
                    var isSelected0 = _.some(_self.c_ListEqp, { No });
					if (isSelected0) {
                        $.showMessageFire({ type: 'error' }, '設備已被選用');
                        _self.$refs.ddl_eqp.sel.clear();
                        return;
					}

                    for (var idx = 0; idx < _支援人員記錄表.length; idx++) {
                        let { subItem:list_eqp } = _支援人員記錄表[idx];
                        if (list_eqp != null && list_eqp.lenght !=0 ) {
                            var isSelected = _.some(list_eqp, { No });
							if (isSelected) {
                                $.showMessageFire({ type: 'error' }, '設備已被選用');
								_self.$refs.ddl_eqp.sel.clear();
								return;
							}
						}
                    }
                    _self.c_ListEqp.push(ItemInfo);
                    _self.$refs.ddl_eqp.sel.clear();
                }
            },
			methods: {
				fn_覆確_exe() {
					var _self = this;
					var param = Object.assign({}, _self.form_cf);
					param.USER_PW = btoa(param.USER_PW);
					param = _self.$UT.isTest(param);

					var url = _self.$URL.chg_Path(`api/ZZ_SJ/User/CancelCheckIn_CF`);
					var _ajax = {
						url,
						param,
						type: 'POST',
						automessage: false,
						success(res) {
							if (res!=null){
								let {list,LotFinishQty} = res;
								_self.TotalFinishQty = LotFinishQty;
								if (list.length == 0){
                                    _self.table_list.splice(_self.curUser_idx, 1);
                                } else {
                                    _self.BindTableRow(list[0]);
                                }
								_self.ShowUserForm = false;
								_self.USER_NO = '';
                                _self.USER_PW = '';
							}
						},
                        error(res) {
                            console.log({ err: res });
                            let { ExceptionMessage, Message } = _.get(res, 'responseJSON', {});
                            var msg = ExceptionMessage || Message || 'API 回應異常!!';
                            _self.$Alert.Err(msg);
                        }
					};
					$.submitForm(_ajax);
 				},
				remove_eqp(idx) {
                    this.c_ListEqp.splice(idx, 1);
				},
                handleClose() { },
				set_cwin(val) {
                    this.dialogVisible = val;
                    var z = val
                        ? $('body').addClass('sj-people-management-adj')
                        : $('body').removeClass('sj-people-management-adj');
                    if (val == false) {
						this.curUser = '';
						this.curUser_idx = -1;
                        this.c_defectList = [];
                        this.c_scrapList = [];
                        this.c_GoodQty = 0;
						this.isChange = false;
                    }
				},
                check_isOverQty(_self, Qty) {
                    var arr = [
                        parseFloat(_.get(_self, 'set_model.CurrentLot.QUANTITY', 0)),
                        parseFloat(_.get(_self, '$store.getters.getData.partialGoodQtyCheckout.qty', 0)),
                        parseFloat(_.get(_self, '$store.getters.getData.GoodComponent.LotGoodQty', 0)),
                    ];
                    var maxQty = _.max(arr);
                    return Qty > maxQty;
				},
				chk_isOver() {
                    var EXE_OUTPUT_QTY = this.c_GoodQty;
					var ScrapList = this.c_scrapList;
                    var ScrapQty = parseFloat(_.sumBy(ScrapList, 'INum'));
					let { QUANTITY } = this.set_model.CurrentLot;
					let { TotalFinishQty, TotalScrapQty } = this;
					var 批號待完工餘數 = (QUANTITY - TotalFinishQty - TotalScrapQty);
					var 報工總數 = (EXE_OUTPUT_QTY + ScrapQty);
                    var isOver = 報工總數 > 批號待完工餘數;
					if (isOver) this.$Alert.Err(`報工總數(${報工總數}) 超過 批號待完工餘數(${批號待完工餘數})`);
					return isOver;
				},
                init_curUser(isNeedConfirm=false) {
					var _self = this;
					var fn = function () {
                        _self.curUser = '';
                        _self.curUser_idx = -1;
                        _self.$refs.selectItem.sel.clear();
					};
					if (isNeedConfirm) {
						_self.$confirm(
                            _self.i18n.請確認是否清除,
							"@RES.BLL.Face.ColumnHint"
						)
						.then(() => {
							fn();
						});
					} else {
						fn();
					}
				},
				SubmitReport() {
					let _self = this;
					let {GoodComponent} = _self.$store.getters.getData;
					var EXE_OUTPUT_QTY = _self.c_GoodQty;
                    var ScrapList = _self.c_scrapList;
                    var DefectList = _self.c_defectList;
					var param = {
						user:_self.curUser
						,DefectList
						,ScrapList
						,LotNo: _self.set_model.CurrentLot.LOT
						,EXE_OUTPUT_QTY
					}
					param = _self.$UT.isTest(param);

					var url = _self.$URL.chg_Path(`api/ZZ_SJ/User/JobReport`);
					var _ajax = {
						url,
						param,
						success(res) {
							if (res != null) {
								var isTest = param.isTest == 'T';
								if (!isTest) {
									let { list, LotFinishQty, LotScrapQty} = res;
									_self.TotalFinishQty = LotFinishQty;
									_self.TotalScrapQty = LotScrapQty;
									_self.BindTableRow(list[0]);
								}

                                _self.$Alert.Success(_self.i18n.SaveSuccessful).then(() => {
                                    if (!isTest) _self.set_cwin(false);
								});
							}
						},
						error(res){
                            //debugger
							console.log({err:res});
							let {ExceptionMessage,Message} = _.get(res,'responseJSON',{});
							var msg = ExceptionMessage || Message || 'API 回應異常!!';
							_self.$Alert.Err(msg);
						}
					};

					_self.$confirm(
						"@RES.BLL.Message.ConfirmAdd?",
						"@RES.BLL.Face.ColumnHint"
					)
					.then(() => {
						$.submitForm(_ajax);
					});

				},
				Action(idx, row){
					this.c_dialog = true;
					this.curUser = row;
					this.curUser_idx = idx;
                    this.$set(this.$store.state, 'curUser', row);
				},
                f_取得預設進站人員資料() {
                    var _self = this;
                    if (_self.set_model.CurrentLot == null) return;

					var param = {
						LotNo: _self.set_model.CurrentLot.LOT
					};
					var url = _self.$URL.chg_Path('api/ddl/GetMuliteStageWorker');
					var _ajax = {
						url,
						param,
						type: 'get',
						automessage: false,
						success: this.f_取得預設進站人員資料_success
					};
					$.submitForm(_ajax);
				},
				f_取得預設進站人員資料_success(res) {
                    if (res != null) {
                        let { list, LotFinishQty, LotScrapQty, LotCheckInQty} = res;
                        this.TotalFinishQty = LotFinishQty;
						this.TotalScrapQty = LotScrapQty;
						if (LotCheckInQty != null) {
                            this.$set(this.set_model.CurrentLot, 'QUANTITY', LotCheckInQty);
						}

                        this.table_list = list;
                    }
				},
				DelRow(idx, row) {
					this.ShowUserForm = true;
                    this.curUser_idx = idx;
                    this.form_cf.row = row;
				},
				DelRow_old(idx, row) {
					let _self = this;
					_self.curUser_idx = idx;
					var LotNo =  _self.set_model.CurrentLot.LOT;
					let {SID:IN_SUPPORT_SID,No:USER_NO } = row;
					var param = {
						IN_SUPPORT_SID,
						USER_NO,
						LotNo,
					};
                    param = _self.$UT.isTest(param);
					//var url = _self.$URL.chg_Path(`api/ZZ_SJ/User/CancelCheckIn?LotNo=${LotNo}&isTest=T`);
					var url = _self.$URL.chg_Path(`api/ZZ_SJ/User/CancelCheckIn`);
					var _ajax = {
						url,
						//contentType:'application/json;charset=utf-8;',
						param,//:JSON.stringify(param),
						type: 'GET',
						//dataType: "json",
						automessage: false,
						success(res) {
							if (res!=null){
								let {list,LotFinishQty} = res;
								_self.TotalFinishQty = LotFinishQty;
								if (list.length == 0){
									_self.table_list.splice(idx, 1);
								}else{
									_self.BindTableRow(list[0]);
								}
							}
						},
                        error(res) {
                            console.log({ err: res });
                            let { ExceptionMessage, Message } = _.get(res, 'responseJSON', {});
                            var msg = ExceptionMessage || Message || 'API 回應異常!!';
                            _self.$Alert.Err(msg);
                        }
					};

					_self.$confirm(
						"@RES.BLL.Message.DeleteConfirm?",
						"@RES.BLL.Face.ColumnHint"
					)
					.then(() => {
						$.submitForm(_ajax);
						@* $.post(url,
							JSON.stringify(param)
							,
							 {
								data: JSON.stringify(param)
								//data: param
							},
							function(data) {
								debugger
								if (data.success) {
									console.log("成功取消登入");
								} else {
									console.error("取消登入失敗", data.error);
								}
							},
							"json" // 指定回傳資料格式為 JSON
						); *@
					});

				},
                BindTableRow(row){
					//debugger
					var _Target = this.table_list[this.curUser_idx];
					for(var key in row){
					 	_Target[key] = row[key];
					}
				},
				api_AddUser() {
					debugger
					let _self = this;
					var LotNo =  _self.set_model.CurrentLot.LOT;
					var param = {
                        user: _self.curUser,
						LotNo,
					};
                    param = _self.$UT.isTest(param);

					var url = _self.$URL.chg_Path(`api/ZZ_SJ/User/CheckIn`);
					var _ajax = {
						url,
						param,
						type: 'post',
						automessage: false,
                        success: _self.api_AddUser_success,
                        error: _self.$Alert.submitForm_Err
					};

					_self.$confirm(
						"@RES.BLL.Message.ConfirmAdd?",
						"@RES.BLL.Face.ColumnHint"
					)
					.then(() => {
						$.submitForm(_ajax);
					});
					_self.$refs.selectItem.sel.clear();
				},
				api_AddUser_success(res) {
                    if (res != null) {
                        let { list, LotFinishQty } = res;
                        this.TotalFinishQty = LotFinishQty;
                        if (this.curUser_idx != -1) {
                            this.BindTableRow(list[0]);
                        } else {
                            this.table_list.push(list[0]);
						}
						this.init_curUser();
                    }
				},
				bind_SHIFT() {
                    var timeSlots = this.set_model.UserShiftList;
                    const now = new Date();
                    const nowTime = now.getHours() * 100 + now.getMinutes();

                    let currentSlot = null;

                    for (let i = 0; i < timeSlots.length; i++) {
                        const slot = timeSlots[i];
                        if (slot.Attr01 == "") continue;

                        const slotTimeRange = slot.Attr01.split("~");
                        if (slotTimeRange.length != 2) continue;
                        const startTime = parseInt(slotTimeRange[0].replace(":", ""));
                        const endTime = parseInt(slotTimeRange[1].replace(":", ""));

                        if (endTime < startTime) {
                            if (nowTime >= startTime || nowTime < endTime) {
                                currentSlot = slot;
                                break;
                            }
                        } else {
                            if (nowTime >= startTime && nowTime < endTime) {
                                currentSlot = slot;
                                break;
                            }
                        }
                    }

                    if (currentSlot) {
                        let { No } = currentSlot;
                        this.selected_Shiftitem = No;
                    }
                }
            },
