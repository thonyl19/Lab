<script>
    //todo-CUB-機台訊息
    $(() => {
        var _tpl = {
            
            Tool_Selected: `
            <div v-if="eqp.subItem && eqp.subItem.length > 0" class="sty-area1" >
                <div v-for="(tool,tool_idx) in eqp.subItem" class="tool_info">
                    <el-tag  type="success" :key="tool.SID" >
                        <i class="fa fa-trash" @@click="remove_tool(eqp , tool_idx)" v-if="isCheckIn"  :class="tool['isNonRemove']"></i>
                        <gt-no-name v-model="tool.Display" :no="tool.No"  tag="span" > </gt-no-name>
                    </el-tag>
                    <gti-limits-info v-model="eqp.subItem[tool_idx].Ext" v-if="c_limits_show"></gti-limits-info>
                    <i class="fa fa-exclamation-circle" v-if="HasToolRule&&tool['link']==null"></i>
                </div>
            </div>
            `,
            Tool_Opction: `
            <div class="sty-tool-input" :class="sty_ToolInput" v-if="Selected.EQP.No==eqp.No">
                <el-input v-model="search_tool" ref="search_tool" size="small" v-if="!HasToolRule">
                    <el-button slot="append" icon="fa fa-search"
                        @@click="f_search_tool"
                    ></el-button>
                </el-input>
                <div class="sty-area1 adj-tool-input" >
                    <div v-for="(tool,tool_idx) in Idx.Tool" class="tool_info"
                        :key="tool.SID"
                        v-show="Selected.Tools[tool.No]==null" >
                        <el-tag type="success" @@click="AddTool(tool)">
                            <gt-no-name v-model="tool.Display" :no="tool.No"  tag="span" >
                            </gt-no-name>
                        </el-tag>
                        <gti-limits-info v-model="Idx.Tool[tool_idx].Ext" v-if="c_limits_show"></gti-limits-info>
                    </div>
                </div>
            </div>
            `,
            cwin_996: `
            <div class="cwin-996" style="display:none">
                <div class="content">
                {{c_win_996}}    
                </div>
                <el-row type="flex" class="row-lg" justify="center">
                    <el-col :span="4"><div></div></el-col>
                    <el-col :span="18">
                        <el-button type="primary" plain @@click="bind_本站機台記錄()">重新選擇可用機台/治具</el-button>
                        <el-button type="primary" plain @@click="bind_上崗設定記錄()">線外執行治具上機台</el-button>
                    </el-col>
                    <el-col :span="2"><div></div></el-col>
                </el-row>
            </div>
            `,

            Dialog: `<el-dialog title="機台&治具零配件" :visible.sync="isExpandData" width="90%">
                    <el-table :data="expandedTableData" style="width: 100%">
                        <el-table-column prop="parentNo" label="設備">
                            <template slot-scope="scope">
                                <gt-no-name v-model="scope.row.parentDisplay" :no="scope.row.parentNo"  :inline="false"></gt-no-name>
                            </template>
                        </el-table-column>
                        <el-table-column prop="parentAttr02" label="已使用次數"></el-table-column>
                        <el-table-column prop="parentAttr03" label="最大使用次數"></el-table-column>
                        <el-table-column prop="subNo" label="治具">
                            <template slot-scope="scope">
                                <gt-no-name v-model="scope.row.subDisplay" :no="scope.row.subNo"  :inline="false"></gt-no-name>
                            </template>
                        </el-table-column>
                        <el-table-column prop="subAttr01" label="治具類別">
                            <template slot-scope="scope">
                                <gt-no-name v-model="scope.row.type_Name" :no="scope.row.type_No"  :inline="false"></gt-no-name>
                            </template>
                        </el-table-column>
                        <el-table-column prop="subAttr02" label="已使用次數"></el-table-column>
                        <el-table-column prop="subAttr03" label="最大使用次數"></el-table-column>
                    </el-table>
                </el-dialog>
            </div>
            `,
            
                Tool_Selected_Report: `
            <div v-if="eqp.subItem && eqp.subItem.length > 0" class="sty-area1" >
                <div v-for="(tool,tool_idx) in eqp.subItem" class="tool_info">
                    <el-tag  type="success" :key="tool.SID" >
                        <i class="fa fa-trash" @@click="remove_tool(eqp,tool_idx)" v-if="ddl_EQP.isFromCatch == false"></i>
                        <gt-no-name v-model="tool.Display" :no="tool.No"  tag="span" ></gt-no-name>
                    </el-tag>
                    <gti-limits-info v-model="eqp.subItem[tool_idx].Ext" v-if="c_limits_show"></gti-limits-info>
                    
                </div>
            </div>
            `,
            Tool_Opction_Report: `
            <div class="sty-tool-input"   v-if="ddl_EQP.isFromCatch == false && Selected.EQP.No==eqp.No">
                <div class="sty-area1 adj-tool-input" >
                    <div v-for="(tool,tool_idx) in Idx.Tool" class="tool_info"
                        :key="tool.SID"
                        v-if="tool.Info.isCanSelect" >
                        <el-tag type="success" @@click="AddTool(tool)">
                            <gt-no-name v-model="tool.Display" :no="tool.No"  tag="span" >
                            </gt-no-name>
                        </el-tag>
                        <gti-limits-info v-model="Idx.Tool[tool_idx].Ext" v-if="c_limits_show"></gti-limits-info>
                    </div>
                </div>
            </div>
            `,
            
                Tool_Selected_Catch: `
                <div v-if="eqp.subItem && eqp.subItem.length > 0" class="sty-area1" >
                    <div v-for="(tool,tool_idx) in eqp.subItem" class="tool_info">
                        <el-tag  type="success" :key="tool.SID" >
                            <i class="fa fa-trash" @@click="remove_tool(eqp,tool_idx)" ></i>
                            <gt-no-name v-model="tool.Display" :no="tool.No"  tag="span" ></gt-no-name>
                        </el-tag>
                        <gti-limits-info v-model="eqp.subItem[tool_idx].Ext" v-if="c_limits_show"></gti-limits-info>
                    </div>
                </div>
                `,
                Tool_Opction_Catch: `
            <div class="sty-tool-input" :class="sty_ToolInput_Catch" v-if="Selected.EQP.No==eqp.No">
                <el-input v-model="search_tool" ref="search_tool" size="small" v-if="!HasToolRule">
                    <el-button slot="append" icon="fa fa-search"
                        @@click="f_search_tool"
                    ></el-button>
                </el-input>
                <div class="sty-area1 adj-tool-input" >
                    <div v-for="(tool,tool_idx) in Idx.Tool" class="tool_info"
                        :key="tool.SID"
                        v-if="tool.Info.isCanSelect" >
                        <el-tag type="success" @@click="AddTool(tool)">
                            <gt-no-name v-model="tool.Display" :no="tool.No"  tag="span" >
                            </gt-no-name>
                        </el-tag>
                        <gti-limits-info v-model="Idx.Tool[tool_idx].Ext" v-if="c_limits_show"></gti-limits-info>
                    </div>
                </div>
            </div>
            `,
            //tag:Debug
            Debug:{
                empty: ``,
            },
        }
        Vue.component('gti-limits', {
            props: {
                sid: {
                    type: String,
                    default: ''
                },
                limit: {
                    type: Number,
                    default: 1
                },
                value: {
                    type: Number,
                    default: 1
                }
            },
            template: `
            <span class="gti-limits">
                (<span :class="sty_over_limit">{{value}}</span>/<span>{{limit}}</span>)
            </span>
            `,
            computed: {
                sty_over_limit(){
                    return this.value < this.limit ? 'is-over-limit' : '';
                }
            }
        })
        //tag: gti-limits-info-table
        Vue.component('gti-limits-info-table', {
           template: `
                <div>
                    <table class="gti-limits-info-table">
                        <tr>
                            <td>累計使用次數</td>
                            <td> {{value.USE_COUNT}} </td>
                        </tr>
                        <tr>
                            <td>{{value.note_使用次數}}使用次數</td>
                            <td>{{value.c_使用次數}}000</td>
                        </tr>
                        <tr>
                            <td colspan=2 class="note" >
                                <span>{{value.note_轉換率}}</span>
                            </td>
                        </tr>
                        <tr>
                            <td>合計使用次數</td>
                            <td>{{value.c_合計使用次數}}000</td>
                        </tr>
                        <tr class="split">
                            <td>最大使用次數</td>
                            <td >{{value.MAX_USE_COUNT}}</td>
                        </tr>
                        <tr>
                            <td >達次保養計數</td>
                            <td >{{value.c_保養計數}}000</td>
                        </tr>
                        <tr >
                            <td colspan=2 class="note" >
                                <sapn>{{value.note_彈性容許率}}note_彈性容許率
                                </sapn>
                                <div>{{value.note_保養單號}}note_保養單號</div>
                            </td>
                        </tr>
                    </table>
                    
                </div>
            `,
            props: {
                value: {
                    type: Object,
                    default: {}
                }
            },
        })
        Vue.component('gti-limits-info', {
            template: `
            <el-tooltip class="gti-limits-info" effect="light"  placement="top">
                <div slot="content">
                    <gti-limits-info-table v-mode="value"></gti-limits-info-table> 
                </div>
                <span class="label label-default" >{{value.c_合計使用次數}}</span>
            </el-tooltip>
            `,
            props: {
                value: {
                    type: Object,
                    default: {}
                }
            },

        })

        var _fn = function () {
            return {
                mixins: [Vue.prototype.$UT.Mixins.v_rootEl()],
                template: `
                <div class="cp-eqp-setup"> 
                    <div class="panel-heading b panel-header-radius gti-wip-title" :class="[isRequired?'req-sty':'']" >
                        <i class="fa fa-list-alt" style="float: right;margin:0 3px;color:#409eff;" v-if="!isCheckIn" @@click="QueryOperUseEqpInfo(true)"></i>
                        <h3 class="panel-title">{{title}}</h3>
                    </div>
                    <gt-err-tag v-model="c_err_req" sid="cp-eqp-setup.req"></gt-err-tag>
                    <gt-err-tag v-model="c_err_tool" sid="cp-eqp-setup.non_oper_tool"></gt-err-tag>
                    <gt-err-tag v-model="c_err_isOver" sid="cp-eqp-setup.isOver"></gt-err-tag>
                    <gt-err-tag v-model="c_err_attr16" sid="cp-eqp-setup.attr16"></gt-err-tag>
                    <div class="sty-ops">
                        <vue-selectize-dynquery
                            ref="ddl_EQP"
                            action="Equipment"
                                        v-model="ddl_EQP.val"
                                        :options="ddl_EQP.src"
                                        :rows.sync="ddl_EQP.rows"
                                        :icon_search="!HasEqpRule"
                                        :fn_query="e_dyn_query"
                                        :icon_search_click="()=>{e_dyn_query(null)}"
                                        render_sty="GTIMES"
                                        @@change-rows="ddl_EQP_onChange"
                                        >
                                        </vue-selectize-dynquery>
                            <div class="clearfix"></div>
                            <el-radio-group v-model="Selected.EQP" class="sty-area" >
                                <el-radio v-for="(eqp,eqp_key) in Idx.EQP"
                                    :key="eqp_key"
                                    :label="eqp" @@click.native.prevent="handleEqpChange(eqp,$event)"
                                    :class="[sty_EnableSetTool]"
                                    >
                                    <span class="eqp_info">
                                        <el-tag>
                                            <i class="fa fa-trash" @@click="remove_eqp(eqp)" ></i>
                                            <gt-no-name v-model="eqp.Display" :no="eqp.No" tag="span" ></gt-no-name>
                                        </el-tag>
                                        <gti-limits-info v-model="Idx.EQP[eqp_key].Ext" ></gti-limits-info>
                                    </span>
                                    ${_tpl.Tool_Selected}
                                    ${_tpl.Tool_Opction}
                                </el-radio>
                            </el-radio-group>
                    </div>
                    ${_tpl.Dialog}
            </div>
			    `,
                props: {
                    "set_model": {
                        type: Object,
                        default: []
                    },
                    cfg: Vue.prototype.$PropDef.Array(),
                    single_tool_add: {
                        type: [String, Boolean],
                        default: true
                    },
                    readonly: {
                        type: [String, Boolean],
                        default: false
                    },
                    err_tag: {
                        type: [String, Boolean],
                        default: false
                    },
                    cfg: Vue.prototype.$PropDef.Array(),
                    checkout_limits: {
                        type: [String, Boolean],
                        default: false
                    },
 
                },
                data() {
                    var _self = this;
                    return {
                        search_tool: '',
                        ddl_EQP: {
                            val: '',
                            src: [],
                            rows: [],
                            isFromCatch: true, 
                        },
                        Selected: {
                            EQP: '',
                            //已被選取的EQP
                            EQPs: {},
                            Tools: {},
                            //不合規需要被移除的治具
                            UnLoad: {},
                            err_達次保養:{},
                            err_達次保養_is:false,
                        },
                        OperSet: {
                            EQP: [],
                            Tool: [],
                        },
                        Catch: {
                            Tool: {},
                            EQP: {},
                            tmp: {},
                        },
                        //以Key值為單的資料集合
                        Idx: {
                            //顯示和執行的依據 
                            EQP: {},
                            Tool: {},
                            //避免執行重覆
                            err_sid: {},
                        },
                        expandedTableData: [],
                        isExpandData: false,
                        Once:{
                            is_after_enter:false,
                            is_before_enter:false,
                            is_before_enter_catch:-1,
                        },
                        c_win_996:'',
                        //tag:RunCode()
                        RunCode:{
                            val:'',
                            "11-1":{
                                desc:"進站前,初始化",
                                fn(){
                                    _self.Catch.EQP = {};
                                    _self.Catch.Tool = {};
                                    _self.Selected.EQP = '';
                                    _.each(_self.Selected.EQPs, (eqp)=>{
                                        _self.remove_eqp(eqp,true);
                                    });
                                    // console.log('11-1', JSON.stringify(_self.Selected.EQPs));
                                    // console.log('11-1', JSON.stringify(_self.Idx.EQP));
                                    
                                }
                            },
                            "21-1":{
                                desc:"上崗前,cp-eqp-catch 調用 QueryOperToolRule",
                                fn(){
                                    //tag: QueryOperToolRule
                                    _self.QueryOperToolRule(false,()=>{
                                        _self.RunCode.val = '21-22';
                                        //_self.api_EqpToolCatch(true);
                                    });
                                }
                            },
                            "21-22":{
                                desc:"上崗前,調用 api_EqpToolCatch",
                                fn(){
                                    _self.api_EqpToolCatch((data)=>{
                                        _self.RunCode.val = '21-23';
                                    });
                                }
                            },
                            "21-23":{
                                desc:"上崗前,調用 f_CatchSyncToIdx",
                                fn(){
                                    _self.f_CatchSyncToIdx();
                                }
                            },
                            "22-1":{
                                desc:"上崗後,cp-eqp-setup 調用 QueryOperToolRule / api_EqpToolCatch",
                                fn(){
                                    _self.QueryOperToolRule(false,()=>{
                                        _self.api_EqpToolCatch((Data)=>{
                                            if (Data == null) {
                                                _self.$Alert.Err("查無上崗前的機台治具記錄資料\n,請重新選擇.");
                                                _self.bind_本站機台記錄();
                                            } else if (_.isArray(Data)) {
                                                console.log('22-1', Data);
                                                for (var _eqp of Data) {
                                                    _eqp.Info.Checked = true;
                                                    _self.$set(_self.Selected.EQPs, _eqp.No, _eqp);
                                                    _self.Rule_達次保養判定(_eqp.SID,_eqp.Ext)
                                                }
                                                _self.c_Return = '';
                                            }
                                        });
                                    });
                                }
                            },
                            "22-2":{
                                desc:"上崗後,ddl_EQP.src 取自 Catch.EQP",
                                fn(vm){
                                    vm.ddl_EQP.src = Object.values(vm.Catch.EQP);
                                    console.log('22-2', JSON.stringify(vm.ddl_EQP.src));
                                }
                            },
 
                        }
                    };
                },
                mounted() {
                    let {EqumentSelectList,ToolSelectList} = this.set_model;
                    this.bind_OperSet(EqumentSelectList,ToolSelectList);
                    var r = this.c_err_req;
                },
                watch: {
                    //#tag:watch_RunCode()
                    'RunCode.val'(val){
                        var _code = this.RunCode[val];
                        if (_code!=null) {
                            _code.fn(this);
                            console.log(`RunCode:${val})${_code.desc}`);
                        }
                    }
                },
                computed: {

                    //#tag:c_UserTrace()
                    c_UserTrace(){
                        var userTrace = _.get(this.$store, 'state.globalvar.UserTrace', null);
                        var check = {
                            before_enter : userTrace.sts == 21,
                            after_enter : userTrace.sts == 31,
                        }
                        return {userTrace,check};
                        
                    },
                    c_生產數(){
                        if (this.c_UserTrace.check.after_enter) {
                            var _GoodList = _.get(this.$store.state, 'globalvar.GoodList') || [];
                            var _ScrapList = _.get(this.$store.state, 'globalvar.ScrapList') || [];
                            var _sum =  parseInt(_.sumBy(_GoodList, 'Qty'))
                                    + parseInt(_.sumBy(_ScrapList, 'Qty'));
                            return _sum;
                        }
                        return _.get(this.set_model,'CurrentLot.QUANTITY',0) 

                    },
                    checkin_unload_tool(){
                        return _.get(this.cfg,'checkin_unload_tool',true);
                    },
                    c_err_req(){
                        if (this.HasEqpRule==false) return '';
                        var msg =  _.isEmpty(this.Selected.EQPs)
                            ?'必須選取機台'
                            :null;
                        this.SetErrGroup('cp-eqp-setup.req', msg);
                        return msg;
                    },
                    c_err_tool(){
                        if ( this.isCheckIn || this.HasToolRule == false || this.checkin_unload_tool == false) return;
                        var r = _.some(this.Idx.EQP, (collection) =>{
                            if (Array.isArray(collection.subItem) && collection.subItem.length > 0){
                                return _.some(collection.subItem,  (tool) => tool.Info.check_RuleB1==false);
                            }
                            return false;
                        });
                        if (this.err_tag && this.OperSet){
                            var msg = r ?'選定的機台上有不符合工作站設定的治具.':null;
                            this.SetErrGroup('cp-eqp-setup.non_oper_tool', msg);
                        }
                        return r;
                    },
                    c_err_isOver(){
                        if (this.checkout_limits == false) return;
                        if (_.isEmpty(this.Selected.EQPs)){
                            this.SetErrGroup('cp-eqp-setup.isOver', null);
                            return ;
                        }
                        var r = _.some(this.Selected.EQPs, (eqp)=>{
                            var isOver_Tool = _.some(eqp.subItem,{Ext:{isOver:true}});
                            var msg = isOver_Tool ?'選定的治具超過最大使用次數.':null;
                            this.SetErrGroup('cp-eqp-setup.isOver', msg);
                            if (isOver_Tool) return isOver_Tool;

                            var isOver_EQP = eqp.Ext.isOver;
                            msg = isOver_EQP ?'選定的機台超過最大使用次數.':null;
                            this.SetErrGroup('cp-eqp-setup.isOver', msg);
                            return isOver_EQP;
                        });
                        return r;
                    },
                    c_err_uco(){
                        if (!this.Selected.err_達次保養_is) return;

                        var msg = "已選定的機台/治具中,有已達到保養計數且開立保養單.";
                        this.SetErrGroup('cp-eqp-setup.uco', msg);
                        // var msg = ;  
                        // this.SetErrGroup('cp-eqp-setup.uco', msg);
                    },
                    c_err_attr16(){
                        if (this.isCheckIn) return;
                        if (this.Idx.EQP.length == 0) return;
                        var _eqp = _.find(this.Idx.EQP,eqp=>eqp.attr16 == 'F');
                        var msg = _eqp != null
                            ?`機台(${_eqp.No}-${_eqp.Display})上沒有合規治具,不允許出站.`
                            :null;
                        this.SetErrGroup('cp-eqp-setup.attr16', msg);
                    },
                    oper_info() {
                        return _.get(this.set_model, 'oper_info', {});
                    },
                    c_limits_show(){
                        return _.get(this.cfg,"limits_show",false);
                    },
                    c_return_traget(){
                        return _.get(this.cfg,"return_traget",'EqpToolList');
                    },
                    //tag:c_Return Base
                    c_Return: {
                        get() {
                            var r = [];
                            let { $store } = this;
                            if ($store) {
                                return _.get($store, `state.globalvar.${this.c_return_traget}`, []);
                            }
                            return r;
                        },
                        set(val) {
                            let { $store } = this;
                            if ($store) {
                                this.$set($store.state.globalvar, this.c_return_traget, this.c_EqpToolList);
                                // var x = [];
                                // _.each(this.Selected.UnLoad,(v,k)=>{
                                //     x = _.concat(x,v);
                                // });
                                // this.$set($store.state.globalvar, 'UnLoadToolList', x);
                            }
                        }
                    },
                    enable_run_in() {
                        return _.get(this.cfg, 'enable_run_in', false);
                    },
                    sty_EnableSetTool() {
                        //var enable_tool = _.get(this.cfg, 'enable_tool', false);
                        return this.ddl_EQP.isFromCatch ? 'adj-hide':'' ;
                    },

                    sty_ToolInput(){
                        var _self = this;
                        let {HasToolRule,sty_EnableSetTool,isCheckIn} = _self;
                        var chk = {
                            HasToolRule,
                            EnableSetTool:sty_EnableSetTool == '',
                            isCheckIn,
                            Rule0(){
                                //all true ,才允許設定治具
                                return this.HasToolRule && this.EnableSetTool && this.isCheckIn;
                            },
                            Rule1(){
                                //尚有未設定治具
                                return _.some(_self.OperSet.Tool,{Checked:false})
                            }
                        }
                        return (chk.Rule0() && chk.Rule1()) ? '':'hide';
                    },
                    isRequired(){
                        return _.get(this.cfg,'required')??true;
                    },
                    isCanAddTool(){
                        return !_.isEmpty(this.Selected.EQP);
                    },
                    isCheckIn(){
                        var sts = _.get(this.set_model,'CurrentLot.STATUS','Wait');
                        return sts == 'Wait';
                    },
				    isOperModel(){
					    let {SID}  = this.oper_info;
					    return SID != null;
				    },
                    title() {
                        let { title = "@RES.BLL.Face.OperEquipInfo" } = this.cfg;
                        return title;
                    },
                    HasToolRule(){
                        let {Tool} = this.OperSet;
                        return !_.isEmpty(Tool);
                    },
                    HasEqpRule(){
                        let {EQP} = this.OperSet;
                        return !_.isEmpty(EQP);
                    },

                    c_EqpToolList(){
                        return Object.values(this.Selected.EQPs);
                    },
                },

                methods: {
                    Rule_達次保養判定(SID,Ext = null){
                        //debugger
                        var isPass = true;
                        var msg = "已選定的機台/治具中,有已達到保養計數.";
                        if (Ext == null){
                            delete this.Selected.err_達次保養[SID]
                            if (_.isEmpty(this.Selected.err_達次保養)){
