                        var fn = (Eqp)=>{
                            var _eqp = _self.Idx.EQP[Eqp.No];
                            _eqp.Ext = _self.parse_Ext(Eqp);
                            //tag: *** 達次保養 卡控
                            _eqp.Info = _self.parse_EqpInfo(Eqp);
                            _eqp.Info.Checked = true;
                            var _chk = _eqp.Ext.達次保養;
                            var isCanAdd = _self.Rule_達次保養判定(_eqp.SID,_eqp.Ext);
                            if (!isCanAdd) {
                                _eqp.Info.Checked = false;
                                return ;
                            }
                            _self.$set(_self.Selected.EQPs,Eqp.No,_eqp);
                            _self.Selected.EQP = _eqp;
                            _self.c_Return = '';
                        };
                        this.api_EqpSetupInfo(Eqp.No,true,fn);
                    },
                    check_允許機台狀態(eqp) {
                        if (this.enable_run_in){
                            console.log('check_允許機台狀態-pass',eqp);
                        } else {
                            let { Status } = eqp;
                            if (Status == 'Run') {
                                this.$Alert.Err("機台狀態為 Run , 不允許選取!");
                                return false;
                            }
                        }
                        return true;
                    },
                    RestEqpToolInfo(Eqp,IncludeTool){
                        var _self = this;
                        var isNeedRestTool = IncludeTool && (Eqp.subItem == null || Eqp.subItem.length == 0);
                        if (isNeedRestTool){
                            _.each(this.Idx.Tool,(tool)=>{
                                if (tool.EqpNo == Eqp.No){
                                    _self.Idx.Tool = _.omit(_self.Idx.Tool,tool.No);
                                }
                            });
                        }else if (Eqp.subItem != null){
                            _.each(Eqp.subItem,(tool)=>{
                                tool.Ext = _self.parse_Ext(tool);
                                tool.Info = _self.parse_ToolInfo(tool,false);
                                tool.Info.Checked = true;
                                _self.$set(_self.Idx.Tool,tool.No,tool);
                                _self.$set(_self.Selected.Tools,tool.No,tool);
                            });
                        }
                        _self.Selected.EQP = Eqp;
                        Eqp.Ext = _self.parse_Ext(Eqp);
                        Eqp.Info = _self.parse_EqpInfo(Eqp);
                        Eqp.Info.Checked = true;
                        _self.$set(_self.Idx.EQP,Eqp.No,Eqp);
                        _self.$set(_self.Selected.EQPs,Eqp.No,Eqp);

                        return Eqp;
                    },
                    api_EqpSetupInfo(EqpNo,IncludeTool = false,cb=null){
                        var _self = this;
                        var url = _self.$URL.chg_Path('api/ddl/EqpSetupInfo',{EqpNo,IncludeTool});
                        var param = { t: Date.now() };

                        var _ajax = {
                            url,
                            param,
                            type:'get',
                            automessage: false,
                            success(data) {
                                if (data == null || data.length == 0) {
                                    _self.$Alert.msg_NoData();
                                } else if (cb != null) {
                                    cb(data);
                                    // _self.RestEqpToolInfo(data,IncludeTool);
                                    // _self.c_Return = '';
                                }
                            },
                            error:_self.$Alert.submitForm_Err
                        };
                        $.submitForm(_ajax);
                    },

                    e_dyn_query(search) {
                        var _self = this;
                        search = search ?? '%';
                        var url = _self.$URL.chg_Path('api/ddl/Equipment',{search});
                        var param = { t: Date.now() };

                        var _ajax = {
                            url,
                            param,
                            type:'get',
                            success(data) {
                                if (data == null || data.length == 0) {
                                    _self.ddl_EQP.src = [];
                                    _self.$Alert.msg_NoData();
                                } else {
                                    _self.ddl_EQP.src = data;
                                }
                            }
                        };
                        $.submitForm(_ajax);
                    },
                },
            };
        }
        //tag:cp-eqp-setup - 報工
        Vue.component('cp-eqp-setup',{
            mixins:[_fn()],
            template: `
                <div class="cp-eqp-setup" >
                    <div class="panel-heading b panel-header-radius gti-wip-title" :class="[isRequired?'req-sty':'']" >
                        <i class="fa fa-list-alt" style="float: right;margin:0 3px;color:#409eff;" v-if="!isCheckIn" @@click="QueryOperUseEqpInfo(true)"></i>
                        <h3 class="panel-title">{{title}}</h3>
                    </div>
                    <el-button type="primary" @@click="err_996()" v-if="false" >{{ddl_EQP.isFromCatch}}</el-button>
                    <gt-err-tag v-model="c_err_req" sid="cp-eqp-setup.req"></gt-err-tag>
                    <gt-err-tag v-model="c_err_tool" sid="cp-eqp-setup.non_oper_tool"></gt-err-tag>
                    <gt-err-tag v-model="c_err_attr16" sid="cp-eqp-setup.attr16"></gt-err-tag>
                    <gt-err-tag sid="cp-eqp-setup.uco"></gt-err-tag>
                    <div class="sty-ops">
                        <vue-selectize-dynquery
                            ref="ddl_EQP"
                            action="Equipment"
                                        v-model="ddl_EQP.val"
                                        :options="c_ddl_EQP_src"
                                        :icon_search="false"
                                        :rows.sync="ddl_EQP.rows"
                                        render_sty="GTIMES"
                                        @@change-rows="ddl_EQP_onChange_Setup"
                                        >
                                        </vue-selectize-dynquery>
                            <div class="clearfix"></div>
                            <el-radio-group v-model="Selected.EQP" class="sty-area" >
                                <el-radio v-for="(eqp,eqp_key) in Selected.EQPs"
                                    :key="eqp_key"
                                    :label="eqp" 
                                    @@click.native.prevent="handleEqpChange(eqp,$event)"
                                    :class="[sty_EnableSetTool]"
                                    >
                                    <span class="eqp_info">
                                        <el-tag>
                                            <i class="fa fa-trash" @@click="remove_eqp(eqp,false)" ></i>
                                            <gt-no-name v-model="eqp.Display" :no="eqp.No" tag="span" ></gt-no-name>
                                        </el-tag>
                                        <gti-limits-info v-model="Idx.EQP[eqp_key].Ext" v-if="c_limits_show"></gti-limits-info>
                                    </span>
                                    ${_tpl.Tool_Selected_Report}
                                    ${_tpl.Tool_Opction_Report}

                                </el-radio>
                            </el-radio-group>
                            ${_tpl.Debug.empty}
                    </div>
                    {{c_RunCode}}
                    ${_tpl.cwin_996}
                    ${_tpl.Dialog}
                    
            </div>
			    `,
            computed:{
                c_RunCode(){
                    var r = this.RunCode.val; 
                    let {userTrace,check} = this.c_UserTrace;
                    if (userTrace.sts == 31){
                        if (this.Once.is_after_enter == false){
                            this.Once.is_after_enter = true;
                            r = '22-1'
                        }
                    }
                    if (userTrace.sts == 11){   
                        this.Once.is_after_enter = false;
                    }
                    this.RunCode.val = r;
                    return '';
                },
                c_ddl_EQP_src(){
                    if (this.ddl_EQP.isFromCatch){
                        return Object.values(this.Catch.EQP);
                    }
                    return Object.values(this.Idx.EQP);
                },
            },
            watch:{
                '$store.state.Err'(val){
                    let { Message, Code} = val;
                    this.err_996(Message);
                }
            },
            methods:{
                err_996(Msg=""){
                    this.c_win_996 = Msg;
                    const windowHeight = 140;
                    const leaveSpace = 10; // 上下各留空 50px
                    const dialogHeight = windowHeight - leaveSpace * 2;

                    layer.open({
                        type: 1,
                        zIndex: 10,
                        area: ['500px', `150px`],
                        title: false,
                        

                        icon: 3,
                        scrollbar: false,
                        resize: false,
                        top: `${leaveSpace}px`,
                        content: $('.cwin-996'), //这里content是一个DOM，注意：最好该元素要存放在body最外层，否则可能被其它的相对元素所影响
                        cancel: function () {
                            //location.reload();
                            return;
                        }
                    });
                },
                bind_上崗設定記錄(){
                    //console.log('bind_上崗設定記錄');
                    this.ddl_EQP.isFromCatch = true;
                    this.api_EqpToolCatch();
                    layer.closeAll();
                },
                bind_本站機台記錄(){
                    this.ddl_EQP.isFromCatch = false;
                    this.QueryOperUseEqpInfo(false,true);
                    layer.closeAll();
                },
                ResetOps(OperUseEqpInfo){
                    //debugger;
                    var _self = this;
                    this.Selected.EQPs = {};
                    this.Selected.Tools = {};
                    this.Idx.EQP = {};
                    this.Idx.Tool = {};
                    this.Selected.EQP = {};
                    var isCatch = this.ddl_EQP.isFromCatch;
                    _.each(OperUseEqpInfo,(Eqp)=>{
                        Eqp.Ext = _self.parse_Ext(Eqp);
                        Eqp.Info = _self.parse_EqpInfo(Eqp);
                        _.each(Eqp.subItem,(Tool)=>{
                            _self.$set(Tool,'Ext',_self.parse_Ext(Tool));
                            _self.$set(Tool,'Info',_self.parse_ToolInfo(Tool,false));
                            //Catch)不為選取  非Catch)為選取
                            if (!isCatch) Tool.Info.Checked = false;
                            _self.$set( _self.Idx.Tool,Tool.No,Tool);
                        });
                        if (!isCatch)Eqp.subItem = [];
                        _self.$set(_self.Idx.EQP,Eqp.No,Eqp);
                    });
                
                    
                },
                //#tag:ddl_EQP_onChange_Setup
                ddl_EQP_onChange_Setup(rows){
                    var _self=this;
                    let [Eqp] = rows||[];
                    if (Eqp!=null){
                        var _Eqp = this.ddl_EQP.isFromCatch 
                            ? this.Catch.EQP[Eqp.No] 
                            : this.Idx.EQP[Eqp.No];

                        this.$nextTick(()=>{
                            this.ddl_EQP.val = '';
                        });
                        if (_Eqp.Info.Checked){
                            this.$Alert.Err("資料己存在");
                        }else{
                            //debugger
                            if (this.ddl_EQP.isFromCatch){
                                _Eqp.Info.Checked = true;
                                this.$set(this.Selected.EQPs,_Eqp.No,_Eqp);
                                //tag: Rule_達次保養判定 --疑似不用 先移除
                                this.Rule_達次保養判定(_Eqp.SID,_Eqp.Ext);


                                this.Selected.EQP = _Eqp;
                                this.c_Return = '';
                            }else{
                                _self.ddl_EQP_onChange_After(_Eqp);
                            }
                            
                        }
                    }
                },
                ByEqpEmptyIdxTool(Eqp){
                    _.each(Eqp.subItem,(tool)=>{
                        var isSameEqp = tool.Info.EqpNo == Eqp.No;
                        if (isSameEqp){
                            _.omit(this.Idx.Tool,tool.No);  
                        }
                    });
                },
                SyncIdxTool(list_tool){
                    var _self = this;  
                    //移除己不在 list_tool 的 Idx.Tool
                    _.each(_self.Idx.Tool,(tool)=>{
                        if (!_.some(list_tool,{No:tool.No})) tool.Info.remove();
                        // {
                        //     // _self.Selected.Tools = _.omit(_self.Selected.Tools,tool.No);
                        //     // tool.Info.RefKey = null;
                        //     // tool.Info.Checked = false;
                        // }
                    });
                    //增加新上機    
                    _.each(list_tool,(tool)=>{
                        var isExist = _self.Idx.Tool[tool.No];
                        if (isExist == null){
                            tool.Ext = _self.parse_Ext(tool);
                            tool.Info = _self.parse_ToolInfo(tool,false);
                            _self.$set(_self.Idx.Tool,tool.No,tool);
                            _self.$set(_self.Selected.Tools,tool.No,tool);
                        }
                    });
 
                },
                //#tag:ddl_EQP_onChange_After report
                ddl_EQP_onChange_After(Eqp){
                    var _self = this;
                    var fn = (Eqp)=>{
                        //Eqp = _tpl.Eqp1_有subItem;
                        var _eqp = _self.Idx.EQP[Eqp.No];
                        _eqp.Ext = _self.parse_Ext(Eqp);
                        _eqp.Info = _self.parse_EqpInfo(Eqp);
                        _eqp.Info.Checked = true;
                        _self.$set(_self.Selected.EQPs,Eqp.No,_eqp);
                        //tag: *** Rule_達次保養判定
                        _self.Rule_達次保養判定(_eqp.SID,_eqp.Ext);


                        _self.Selected.EQP = _eqp;
                        //tag:清除相應關聯
                        if(Eqp.subItem == null){
                            _self.ByEqpEmptyIdxTool(Eqp);
                        }else{
                            _self.SyncIdxTool(Eqp.subItem);
                        }
                        //tag:重設關聯
                        _self.c_Return = '';
                    };
                    this.api_EqpSetupInfo(Eqp.No,true,fn);
                }
            }
        });
        //tag:cp-eqp-catch
        Vue.component('cp-eqp-catch',{
            mixins:[_fn()],
            template: `
                <div class="cp-eqp-setup cp-eqp-catch" v-if="HasEqpRule">
                    <div class="panel-heading b panel-header-radius gti-wip-title" :class="[isRequired?'req-sty':'']" >
                        <i class="fa fa-list-alt" style="float: right;margin:0 3px;color:#409eff;" v-if="!isCheckIn" @@click="QueryOperUseEqpInfo(true)"></i>
                        <h3 class="panel-title">{{title}}</h3>
                    </div>
                    <gt-err-tag sid="cp-eqp-setup.uco"></gt-err-tag>
                    <gt-err-tag v-model="c_err_isOver" sid="cp-eqp-setup.isOver"></gt-err-tag>
                    <div class="sty-ops">
                        <vue-selectize-dynquery
                            ref="ddl_EQP"
                            action="Equipment"
                                        v-model="ddl_EQP.val"
                                        :options="ddl_EQP.src"
                                        :icon_search="false"
                                        :rows.sync="ddl_EQP.rows"
                                        render_sty="GTIMES"
                                        @@change-rows="ddl_EQP_onChange"
                                        >
                                        </vue-selectize-dynquery>
                            <div class="clearfix"></div>
                            <el-radio-group v-model="Selected.EQP" class="sty-area" >
                                <el-radio v-for="(eqp,eqp_key) in Selected.EQPs"
                                    :key="eqp_key"
                                    :label="eqp" 
                                    @@click.native.prevent="handleEqpChange(eqp,$event)"
                                    >
                                    <span class="eqp_info">
                                        <el-tag>
                                            <i class="fa fa-trash" @@click="remove_eqp(eqp,true)" ></i>
                                            <gt-no-name v-model="eqp.Display" :no="eqp.No" tag="span" ></gt-no-name>
                                        </el-tag>
                                        <gti-limits-info v-model="Idx.EQP[eqp_key].Ext" ></gti-limits-info>
                                    </span>
                                    ${_tpl.Tool_Selected_Catch}
                                    ${_tpl.Tool_Opction_Catch}
                                </el-radio>
                            </el-radio-group>
                            {{c_RunCode}}
                            ${_tpl.Debug.empty}
                    </div>
                    ${_tpl.Dialog}
            </div>
            `,
            mounted(){
                let {EqumentSelectList,ToolSelectList} = this.set_model;
                this.bind_OperSet(EqumentSelectList,ToolSelectList);
            },
            computed: {
                c_RunCode(){
                    //debugger;
                    var r = this.RunCode.val; 
                    let {userTrace,check} = this.c_UserTrace;
                    //console.log({userTrace,check});
                    if (userTrace.sts == 21){
                        if (this.Once.is_before_enter == false){
                            this.Once.is_before_enter = true;
                            $('.cp-eqp-catch').parent().show();
                            r= '21-1';
                        }
                    }else{
                        this.Once.is_before_enter = false;
                        $('.cp-eqp-catch').parent().hide();
                    }
                    if (userTrace.sts == 11 && userTrace.KEY == null){
                        r= '11-1';
                    }
                    this.RunCode.val = r;
                    return '';
                },
                title() {
                    let { title = "選用機台治具" } = this.cfg;
                    return title;
                },
                sty_EnableSetTool(){
                    return '';
                },
                sty_ToolInput_Catch(){
                    let {HasToolRule} = this;
                    var isCanSelect =  _.some(this.OperSet.Tool,item => item.Info.isCanSelect);
                    return (HasToolRule && isCanSelect) ? '':'hide';
                },

            },
            methods: {
                //#tag:bind_Catch
                //bind_Catch(){
                f_CatchSyncToIdx(){
                    var _self = this;
                    _.each(_self.Catch.EQP,(Eqp,key)=>{
                        var _eqp = _self.Idx.EQP[key];
                        _eqp.Info.Checked = true;
                        _self.$set(_self.Selected.EQPs,key,_eqp);
                        if (Eqp.subItem != null){
                            _.each(Eqp.subItem,(tool)=>{
                                var _tool = _self.Idx.Tool[tool.No];
                                _tool.Info.Checked = true;
                                _self.Selected.Tools[tool.No] = _tool;
                                _eqp.subItem.push(_tool);
                            });
                        }
                        //todo: 快取-達次檢核觸發
                        _self.Rule_達次保養判定(_eqp.SID,_eqp.Ext)
                    });
                    _self.Once.is_before_enter_catch = 1;
                    _self.c_Return = '';
                },
                //tag:Catch 機台治具設定
                check_OperSet(list_epq) {
                    var _self = this;
                    _.each(list_epq,(eqp)=>{
                        eqp.Ext = _self.parse_Ext(eqp);
                        if (eqp.subItem !=null){
                            var _arr= []
                            eqp.subItem.forEach(tool=>{
                                let {No,RefKey} = tool;
                                tool.Ext = _self.parse_Ext(tool,eqp);
                                var matchTool = _self.Idx.Tool[No];
                                if (matchTool) {
                                    _self.$set(tool,'link',matchTool.SID); 
                                    matchTool.Checked = true;
                                    _self.Selected.Tools[No] = matchTool;
                                    _arr.push(tool);
                                }
                            })
                            eqp.subItem = [];
                        }
                    })
                    return list_epq;
                },
            }
        });
    });
</script>
