                padding-top: .5rem;
                width: 35px !important;
            }

        .menu-bts {
            padding-top: 1rem;
            padding-right: 1rem;
            padding-left: 26rem;
            height: 55px;
            min-width: 15rem;
            width: 100%;
            position: relative;
            text-align: right;
        }


            .menu-bts > .is-circle {
                float: right;
                margin-left: .9rem !important;
                width:37px;
            }

            .menu-bts > .is-round {
                margin-right:2rem;
            }

            .area-fastAI {
                position: absolute;
            }

        @@media (min-width: 1200px) {
            .area-fastAI input {
                width: 40rem !important;
            }
            .menu-bts .el-button {
                font-size: 1.5rem;
            }
        }

            </style>

