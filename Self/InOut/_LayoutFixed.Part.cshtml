<head>
    <style>
        body {
            padding-top: 60px;
            padding-bottom: 40px;
        }

        .container2 {
            width: 95%;
            margin: 0 auto; /* Center the DIV horizontally */
        }

        .fixed-header, .fixed-footer {
            width: 100%;
            position: fixed;
            background: #333;
            opacity: 0.9;
            padding: 0 0;
            color: #fff;
            z-index: 9999;
        }

            .fixed-header .navbar-header {
                width: 100% !important;
            }

            .fixed-header .navbar-brand {
                width: 50px !important;
            }


        .fixed-header {
            top: 0;
        }

        .fixed-footer {
            bottom: 0;
        }
        nav a {
            color: #fff;
            text-decoration: none;
            padding: 7px 25px;
            display: inline-block;
        }

        .container2 p {
        }

        .selectize-dropdown {
            z-index: 9999 !important;
        }

        div.brand-logo1.adj {
            padding:1rem;
        }
