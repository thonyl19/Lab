@{
	bool isSingleModel = (bool)ViewData["SingleModel"];

	if (isSingleModel)
	{
		Layout = "~/Views/Shared/_LayoutSingle.cshtml";
		@eBundle.QRender_CSS();
		@eBundle.QRender_JS();
	}
}

<style>
    .el-input .el-select {
        width: 110px;
    }
        .el-input .el-select .el-button {
            width: 110px;
        }
</style>
<div id="app">
    <gt-toolbar :e_Add="Add" test_permission="true">
        
    </gt-toolbar>
    <div class="panel b">
        <div class="panel-body">
            <form id="form_main" class="panel-body form-horizontal gt-form">
                <div class="col-lg-6 col-md-12 adj">
                    <gt-form-col label='主機' col_sty="col-lg-12">
                        <el-radio-group v-model="form.IP">
                            <el-radio :label="val" v-for="val in ops.IP">{{val}}</el-radio>
                        </el-radio-group>
                    </gt-form-col>
                    <gt-form-col label='專案' col_sty="col-lg-12">
                        <el-select v-model="form.Project" :clearable="true">
                            <el-option v-for="item in ops.Project"
                                       :key="item"
                                       :label="item"
                                       :value="item">
                            </el-option>
                        </el-select>
                    </gt-form-col>
                </div>
                <div class="col-lg-6 col-md-12 adj">
                    <gt-form-col label="MES" col_sty="col-lg-12">
                    </gt-form-col>
                    <gt-form-col label="SPC" col_sty="col-lg-12">
                    </gt-form-col>
                    <gt-form-col label="RES" col_sty="col-lg-12">
                    </gt-form-col>
                </div>
            </form>
            <hr />
            <div class="clearfix hidden-xs"></div>
            <ul>
                <li v-for="val in ops.DB">{{val}}</li>
            </ul>
            
        </div>
    </div>
</div>


        <script>
            $(() => {
                const converter = OpenCC.Converter({ from: 'hk', to: 'cn' });
                new Vue({
                    el: '#app',
                    data() {
                        return {
                            ops: {
                                IP: [51, 52],
                                Project: ['Prd', 'CUB', 'SJ', 'DAE', 'TCI', 'MWF'],
                                DB: [
                                    "CUB_0116_GTIMES5",
                                    "CUB_0116_METADATA",
                                    "CUB_0116_RESOURCE5",
                                    "CUB_0116_RPT_RESOURCE5",
                                    "CUB_0116_SPC5",
                                    "CUB_GTIMES5",
                                    "CUB_METADATA"
                                ],
                            },
                            activeName: 'A',
                            textarea: '',
                            trans_list:[],
                            options: [{
                                value: 'Face',
                                label: 'Face'
                            }, {
                                    value: 'Message',
                                    label: 'Message'
                                },],
                            form: {
                                Project:'@BLL.Base.ServicesBase.ProjectCustomer',
                                IP:51,
                                res:'Face',
                                key: '',
                                en: '',
                                tw: '',
                                cn: '',
                            },
                            A: i18next.t('transferQtyTooMuch').format('A'),
                            project: {
                                val:'',
                                src: [{
                                    value: 'M_Prd',
                                    label: '產品'
                                }, {
                                    value: 'F_DAE',
                                    label: '大鐿'
                                }, {
                                    value: 'K_MWF',
                                    label: '美吾華'
                                }],
                            } 
                        }
                    },
                    computed: {
                        c_key() {
                            return `${this.form.res}.${this.form.key}`;
                        },
                        c_tw: {
                            get() {
                                return this.form.tw;
                            },
                            set(val) {
                                this.form.tw = val;
                                this.form.cn = converter(val);
                            }
                        },
                        c_textarea() {
                            return this.textarea.split('\n');
                        },
                         
                    },
                    methods: {
                        search_key() {
                            alert('test');
                            var url = _self.$URL.chg_Path(`DDD/APP/i18n/Search/${_self.c_tw}`);
                            var _ajax = {
                                url,
                                type: 'get',
                                automessage: false,
                                success(res) {
                                    const h = _self.$createElement;
                                    let { Success, Message, Data } = res
                                    _self.$notify({
                                        title: Message,
                                        message: h('pre', { style: 'color: teal' }, JSON.stringify(Data, null, 4)),
                                        type: Success ? 'success' : 'warning'
                                    });
                                }
                            };
                            $.submitForm(_ajax);
                        },
                        trans_key() {
                            this.form.key = this.capitalizeWordsAndJoin(this.form.en);
                        },
                        trans() {
                            this.trans_list.push(this.form.tw);
                        },
                        tt(event) {
                            const clickedElement = event.target;
                            this.form.en = event.target.outerText;
                            this.form.key = this.capitalizeWordsAndJoin(this.form.en);
                            clickedElement.remove();
                        },
                        //todo-self: 依key 值, 直接將資料轉入當前專案中
                        get_key() {
                            var _self = this;
                            if (_self.c_tw == "") return;
                            var url = _self.$URL.chg_Path(`DDD/APP/i18n/Search/${_self.c_tw}`);
                            var _ajax = {
                                url,
                                type: 'get',
                                automessage: false,
                                success(res) {
                                    const h = _self.$createElement;
                                    let { Success, Message, Data } = res
                                    _self.$notify({
                                        title: Message,
                                        message: h('pre', { style: 'color: teal' }, JSON.stringify(Data, null, 4)),
                                        type: Success ? 'success' : 'warning'
                                    });
                                }
                            };
                            $.submitForm(_ajax);
                        },
                        Search() {
                            var _self = this;
                            if (_self.c_tw == "") return;
                            var url = _self.$URL.chg_Path(`DDD/APP/i18n/Search/${_self.c_tw}`);
                            var _ajax = {
                                url,
                                type: 'get',
                                automessage: false,
                                success(res) {
                                    const h = _self.$createElement;
                                    let { Success, Message, Data } = res
                                    _self.$notify({
                                        title: Message,
                                        message: h('pre', { style: 'color: teal' }, JSON.stringify(Data,null,4)),
                                        type: Success ? 'success' : 'warning'
                                    });
                                }
                            };
                            $.submitForm(_ajax);
                        },
                        Add() {
                            var _self = this;
                            if (_self.c_tw == "") return;
                            let { res, key, en, tw, cn } = _self.form;
                            var param = { en, tw, cn };
                            var url = _self.$URL.chg_Path(`DDD/APP/i18n/Add/${res}/${key}/`);
                            var _ajax = {
                                url,
                                type: 'post',
                                param,
                                automessage: false,
                                success(res) {
                                    const h = _self.$createElement;
                                    let { Success, Message, Data } = res
                                    _self.$notify({
                                        title: Message,
                                        message: h('pre', { style: 'color: teal' }, JSON.stringify(Data, null, 4)),
                                        type: Success ? 'success' : 'warning'
                                    });
                                }
                            };
                            $.submitForm(_ajax);
                        },
                        Copy(e) {
                            var val = e.target.innerHTML;
                            navigator.clipboard.writeText(val)
                                .then(() => {
                                    this.$message({
                                        showClose: true,
                                        message: '文字已複製到剪貼簿！',
                                        //type: 'success'
                                    });
                                })
                                .catch((error) => {
                                    this.$message({
                                        showClose: true,
                                        message: `複製到剪貼簿時發生錯誤：${error}`,
                                        type: 'error'
                                    });
                                });
                        },
                        capitalizeWordsAndJoin(sentence) {
                            // 將句子按空白和逗號分割成單詞陣列
                            const words = sentence.split(/[ ,!?]+/);

                            // 使用 map 函數處理每個單詞，首字母大寫，其餘小寫
                            const capitalizedWords = words.map(word => {
                                if (word.length > 1) {
                                    return word.charAt(0).toUpperCase() + word.slice(1).toLowerCase();
                                } else {
                                    return word.toUpperCase(); // 單字只有一個字元，全部轉為大寫
                                }
                            });

                            // 重組成一個字符串，使用空格分隔
                            const result = capitalizedWords.join('');

                            return result;
                        }
                    },
                })
            });
        </script>
