                       :key="item.value"
                       :label="item.label"
                       :value="item.value">
            </el-option>
        </el-select>
        <div style="display: inline-block; vertical-align: middle; margin-left: 6px;">Line 001</div>

    </div>

    <div v-cloak class="dbd-c container-fluid">

        <div class="row">
            <div class="col-sm-6">
                <div class="cht-div cht-div-A">
                    <span :class="{'cht-title':!nightMode, 'cht-title-night':nightMode}">Capacity Percentage</span>
