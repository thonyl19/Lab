@using System.Dynamic
@{
	dynamic data = new ExpandoObject();
    GTI_Test GTest = new GTI_Test(Html, ViewContext.HttpContext);
}
@eBundle.QRender_CSS()
@eBundle.QRender_JS()
<script src="//cdn.jsdelivr.net/npm/sortablejs@1.8.4/Sortable.min.js"></script>
<script src="//cdnjs.cloudflare.com/ajax/libs/Vue.Draggable/2.20.0/vuedraggable.umd.min.js"></script>

<div id="app">
    <el-select v-model="selectedColumns"
               multiple
               placeholder="选择显示的列"
               @@change="updateColumns">
        <el-option v-for="column in allColumns"
                   :key="column.prop"
                   :label="column.label"
                   :value="column"></el-option>
    </el-select>
    {{selectedColumns}}
    <div ref="tableHeader" class="table-header">


        <transition-group tag="el-table" :data="tableData" style="width: 100%">
            <el-table-column v-for="column in displayedColumns"
                             :key="column.prop"
                             :prop="column.prop"
                             :label="column.label"
                             :width="column.width">
            </el-table-column>
        </transition-group>

    </div>
    {{displayedColumns}}
</div>


    <script>
        $(() => {
            new Vue({
                el: '#app',
                data() {
                    return {
                        tableData: [
                            {
                                "LOT_SPLIT_SID": "GTI24052813480613909",
                                "LOT_SID": "GTI24052223350484226",
                                "LOT": "45105-2404290006-01.003",
                                "ROUTE_VER_OPER_SID": "GTI24050215593274943",
                                "OPERATION": "贴附包装",
                                "ACTION": "LOT_SPLIT",
                                "APPLICATION_NAME": "StationCheckOut",
                                "ACTION_LINK_SID": "GTI24052813480213886",
                                "ACTION_REASON": null,
                                "ACTION_DESCRIPTION": null,
                                "SUB_LOT_SID": "GTI24052813480613908",
                                "SUB_LOT": "AAAA",
                                "REASON_SID": null,
                                "REASON_NO": null,
                                "REASON": null,
                                "SPLIT_DESCRIPTION": null,
                                "SPLIT_QUNATITY": 60.00000,
                                "SPLIT_QTY_1": 0.00000,
                                "SPLIT_QTY_2": 0.00000,
                                "CREATE_USER": "WebSignage",
                                "CREATE_DATE": "2024-05-28T13:48:02",
                                "UPDATE_USER": "WebSignage",
                                "UPDATE_DATE": "2024-05-28T13:48:02"
                            }
                        ],
                        allColumns: [
                            { prop: 'LOT_SPLIT_SID', label: 'LOT_SPLIT_SID' },
                            { prop: 'LOT_SID', label: 'LOT_SID' },
                            { prop: 'LOT', label: 'LOT' },
                            { prop: 'ROUTE_VER_OPER_SID', label: 'ROUTE_VER_OPER_SID' },
                            { prop: 'OPERATION', label: 'OPERATION' },
                            { prop: 'ACTION', label: 'ACTION' },
                            { prop: 'APPLICATION_NAME', label: 'APPLICATION_NAME' },
                            { prop: 'ACTION_LINK_SID', label: 'ACTION_LINK_SID' },
                            { prop: 'ACTION_REASON', label: 'ACTION_REASON' },
                            { prop: 'ACTION_DESCRIPTION', label: 'ACTION_DESCRIPTION' },
                            { prop: 'SUB_LOT_SID', label: 'SUB_LOT_SID' },
                            { prop: 'SUB_LOT', label: 'SUB_LOT' },
                            { prop: 'REASON_SID', label: 'REASON_SID' },
                            { prop: 'REASON_NO', label: 'REASON_NO' },
                            { prop: 'REASON', label: 'REASON' },
                            { prop: 'SPLIT_DESCRIPTION', label: 'SPLIT_DESCRIPTION' },
                            { prop: 'SPLIT_QUNATITY', label: 'SPLIT_QUNATITY' },
                            { prop: 'SPLIT_QTY_1', label: 'SPLIT_QTY_1' },
                            { prop: 'SPLIT_QTY_2', label: 'SPLIT_QTY_2' },
                            { prop: 'CREATE_USER', label: 'CREATE_USER' },
                            { prop: 'CREATE_DATE', label: 'CREATE_DATE' },
                            { prop: 'UPDATE_USER', label: 'UPDATE_USER' },
                            { prop: 'UPDATE_DATE', label: 'UPDATE_DATE' }
                        ],
                        selectedColumns: [],
                    };
                },
                mounted() {
                    this.$nextTick(() => {
                        const el = this.$refs.tableHeader.querySelector('.el-table__header-wrapper tr');
                        Sortable.create(el, {
                            handle: '.cell',
                            animation: 150,
                            onEnd: evt => {
                                const movedItem = this.displayedColumns.splice(evt.oldIndex, 1)[0];
                                this.displayedColumns.splice(evt.newIndex, 0, movedItem);
                                // 强制触发 Vue 的反应式更新
                                this.selectedColumns = [...this.displayedColumns];
                                this.$forceUpdate();

                            }
                        });
                    });
 
                },
                computed: {
                    displayedColumns() {
                        return this.selectedColumns.length ? this.selectedColumns : this.allColumns;
                    }
                },
                methods: {
                    updateColumns() {
                        this.displayedColumns = [...this.selectedColumns];
                    }
                }
            })
        });
    </script>
    <style>
        .table-header {
            margin-top: 20px;
        }

    </style>
