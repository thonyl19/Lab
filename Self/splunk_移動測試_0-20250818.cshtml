@using System.Dynamic
@{
	bool isSingleModel = (bool)ViewData["SingleModel"];
	if (true)
	{
		Layout = "~/Views/Shared/_LayoutSingle.cshtml";
	}
    GTI_Test GTest = new GTI_Test(Html, ViewContext.HttpContext);
}
@eBundle.QRender_CSS()
@eBundle.QRender_JS()
<pre>
</pre>
<div style="margin:1rem;">
  <div id="app">
	@* <img src="@Url.Content("~/Content/Images/Factory_area.jpg")" alt="My Image" /> *@
    <el-row :gutter="20">
      <!-- 左側場域 -->
      <el-col :span="12">
        <div
          class="grid-container"
          :style="{
            gridTemplateColumns: 'repeat(' + MainArea.X + ', 20px)',
            gridTemplateRows: 'repeat(' + MainArea.Y + ', 20px)',
            backgroundImage: MainArea.backgroundUrl ? 'url(' + MainArea.backgroundUrl + ')' : 'none'
          }"
        >
          <template v-for="y in MainArea.Y" :key="'row-' + y">
            <div
              v-for="x in MainArea.X"
              :key="'cell-' + x + '-' + y"
              class="grid-cell"
              :class="{
                forbidden: isForbidden(x, MainArea.Y - y + 1),
                limited: getLimitedAreaColor(x, MainArea.Y - y + 1)
              }"
              :style="Object.assign(getCellStyle(x, MainArea.Y - y + 1), { border: showGrid ? '1px solid rgba(0,0,0,.2)' : 'none' })"
              @@click="onCellClick(x, MainArea.Y - y + 1)"
            ></div>
          </template>
          <!-- 活動點 -->
          <div
            v-for="point in points"
            :key="'point-' + point.id"
            class="point"
            :style="{
              left: (point.x - 1) * 20 + 'px',
              bottom: (point.y - 1) * 20 + 'px',
              backgroundColor: point.color
            }"
          ></div>
        </div>
      </el-col>

      <!-- 右側設置區 -->
      <el-col :span="12">
        <el-tabs v-model="activeTab">
          <!-- 場域範圍 -->
          <el-tab-pane label="場域範圍" name="area">
                <el-switch v-model="showGrid" active-text="顯示格線" inactive-text="隱藏格線"></el-switch>
            <el-form label-position="right">
              <el-form-item label="X">
                <el-input-number v-model="MainArea.X" :min="1" @@change="onAreaSizeChange"></el-input-number>
              </el-form-item>
              <el-form-item label="Y">
                <el-input-number v-model="MainArea.Y" :min="1" @@change="onAreaSizeChange"></el-input-number>
              </el-form-item>
              <el-form-item label="背景圖 URL">
                <el-input v-model="MainArea.backgroundUrl" width="80px"></el-input>
              </el-form-item>
              <p>(1,1) 為左下，(X,Y) 為右上</p>
            </el-form>
          </el-tab-pane>

          <!-- 禁入區域 -->
          <el-tab-pane label="禁入區域" name="forbidden">
            <p>目前為禁入設置模式，點擊左側場域的格子即可加入/移除禁入</p>
            <el-button type="danger" @@click="clearForbidden">清空全部禁入</el-button>
          </el-tab-pane>

          <!-- 限制區域 -->
          <el-tab-pane label="限制區域" name="limited">
            <el-button type="primary" @@click="addLimitedArea">新增限制區</el-button>
            <el-table :data="LimitedAreas" style="margin-top:10px" >
              <el-table-column label="ID" prop="id" width="60px">
                <template slot-scope="scope">
                  <span :style="{color: scope.row.color}">●</span> {{ scope.row.id }}
                </template>
              </el-table-column>
              <el-table-column label="操作">
                <template slot-scope="scope">
                  <el-radio @@change="selectLimitedArea(scope.row.id)" :value="scope.row.id" v-model="currentLimitedArea"></el-radio>
                  <el-button type="text" @@click="removeLimitedArea(scope.row.id)">移除</el-button>
                </template>
              </el-table-column>
            </el-table>
            <p>點擊左側場域格子，即對當前限制區加入/移除該格。禁入優先不設定限制區。</p>
          </el-tab-pane>

          <!-- 活動點 -->
          <el-tab-pane label="活動點" name="points">
            <el-button type="primary" @@click="addPoint">新增活動點</el-button>
            <el-table :data="points" style="margin-top:10px" >
              <el-table-column label="ID" prop="id" width="60px">
                <template slot-scope="scope">
                  <span :style="{color: scope.row.color}">●</span> {{ scope.row.id }}
                </template>
              </el-table-column>
              <el-table-column label="控制">
                <template slot-scope="scope">
                  <el-radio v-model="activePointId" :label="scope.row.id" @@change="setActivePoint(scope.row.id)"></el-radio>
                  <el-select v-model="scope.row.mode" size="small">
                    <el-option label="手動" value="manual"></el-option>
                    <el-option label="自動" value="auto"></el-option>
                  </el-select>
                  <el-button type="text" @@click="removePoint(scope.row.id)">移除</el-button>
                </template>
              </el-table-column>
              <el-table-column label="已進入區域" prop="enteredAreas" width="180px">
                <template slot-scope="scope">
                  {{ scope.row.enteredAreas.join(', ') }}
                </template>
              </el-table-column>
            </el-table>
          </el-tab-pane>
        </el-tabs>
      </el-col>
    </el-row>
	  {{currentLimitedArea}}
  </div>

</div>

<script>
Vue.config.devtools = true;

$(() => {
  new Vue({
    el: '#app',
    data() {
      return {
        activeTab: 'area',
        MainArea: { X: 30, Y: 20, backgroundUrl: '/GenesisNewMes/Content/Images/Factory_area.jpg' 
		
		},
        RestrictedArea: {},
        LimitedAreas: [],
        currentLimitedArea: null,
        points: [],
        activePointId: null,
        showGrid: true
      };
    },
    mounted() {
      window.addEventListener('keydown', this.onKeyDown);
      setInterval(this.autoMovePoints, 500);
    },
    methods: {
      isForbidden(x, y) {
        return this.RestrictedArea[x] && this.RestrictedArea[x][y];
      },
      getLimitedAreaColor(x, y) {
        for (let area of this.LimitedAreas) {
          if (area.cells[x] && area.cells[x][y] && !this.isForbidden(x, y)) {
            return area.color;
          }
        }
        return null;
      },
      getCellStyle(x, y) {
        let bg = '';
        const color = this.getLimitedAreaColor(x, y);
        if (this.isForbidden(x, y)) bg = '#555';
        else if (color) bg = this.hexToRgba(color, 0.3);
        return { backgroundColor: bg };
      },
      hexToRgba(hex, alpha) {
        let r = parseInt(hex.slice(1, 3), 16);
        let g = parseInt(hex.slice(3, 5), 16);
        let b = parseInt(hex.slice(5, 7), 16);
        return `rgba(${r},${g},${b},${alpha})`;
      },
      toggleForbidden(x, y) {
        if (!this.RestrictedArea[x]) Vue.set(this.RestrictedArea, x, {});
        if (this.RestrictedArea[x][y]) Vue.delete(this.RestrictedArea[x], y);
        else Vue.set(this.RestrictedArea[x], y, true);
      },
      toggleLimitedCell(areaId, x, y) {
        const area = this.LimitedAreas.find(a => a.id === areaId);
        if (!area) return;
        if (!area.cells[x]) Vue.set(area.cells, x, {});
        if (area.cells[x][y]) Vue.delete(area.cells[x], y);
        else Vue.set(area.cells[x], y, true);
      },
      onCellClick(x, y) {
        if (this.activeTab === 'forbidden') this.toggleForbidden(x, y);
        else if (this.activeTab === 'limited' && this.currentLimitedArea) {
          if (!this.isForbidden(x, y)) this.toggleLimitedCell(this.currentLimitedArea, x, y);
        }
      },
      clearForbidden() {
        this.RestrictedArea = {};
      },
      addLimitedArea() {
        const id = 'L' + (this.LimitedAreas.length + 1);
        const color = '#' + Math.floor(Math.random()*16777215).toString(16).padStart(6,'0');
        this.LimitedAreas.push({ id, color, cells: {} });
      },
      removeLimitedArea(id) {
        this.LimitedAreas = this.LimitedAreas.filter(a => a.id !== id);
        if (this.currentLimitedArea === id) this.currentLimitedArea = null;
      },
      selectLimitedArea(id) { this.currentLimitedArea = id; },
      addPoint() {
        const id = 'P' + (this.points.length + 1);
        const color = '#' + Math.floor(Math.random()*16777215).toString(16).padStart(6,'0');
        this.points.push({ id, x: 1, y: 1, color, isActive: true, mode: 'manual', enteredAreas: [], lastDirection: null });
        this.activePointId = id;
        this.setActivePoint(id);
      },
      removePoint(id) {
        this.points = this.points.filter(p => p.id !== id);
        if (this.activePointId === id) this.activePointId = null;
      },
      setActivePoint(id) {
        this.activePointId = id;
        this.points.forEach(p => p.isActive = p.id === id);
      },
      recalcEnteredAreas(point) {
        const areas = [];
        for (let area of this.LimitedAreas) {
          if (area.cells[point.x] && area.cells[point.x][point.y]) areas.push(area.id);
        }
        point.enteredAreas = areas;
      },
      onKeyDown(e) {
        const point = this.points.find(p => p.isActive && p.mode==='manual');
        if (!point) return;
        let dx=0, dy=0;
        switch(e.key) {
          case 'ArrowUp': dy=1; break;
          case 'ArrowDown': dy=-1; break;
          case 'ArrowLeft': dx=-1; break;
          case 'ArrowRight': dx=1; break;
          default: return;
        }
        const nx = point.x + dx;
        const ny = point.y + dy;
        if (nx<1 || nx>this.MainArea.X || ny<1 || ny>this.MainArea.Y) return;
        if (this.isForbidden(nx, ny)) return;
        point.x = nx; point.y = ny;
        this.recalcEnteredAreas(point);
      },
      autoMovePoints() {
        for (let point of this.points) {
          if (point.mode !== 'auto') continue;
          const dirs = [{dx:0,dy:1, name:'up'}, {dx:0,dy:-1, name:'down'}, {dx:-1,dy:0, name:'left'}, {dx:1,dy:0, name:'right'}];
          const possible = dirs.filter(d => {
            const nx = point.x + d.dx;
            const ny = point.y + d.dy;
            if (nx<1 || nx>this.MainArea.X || ny<1 || ny>this.MainArea.Y) return false;
            if (this.isForbidden(nx, ny)) return false;
            if (point.lastDirection==='up' && d.name==='down') return false;
            if (point.lastDirection==='down' && d.name==='up') return false;
            if (point.lastDirection==='left' && d.name==='right') return false;
            if (point.lastDirection==='right' && d.name==='left') return false;
            return true;
          });
          if (possible.length===0) continue;
          const step = possible[Math.floor(Math.random()*possible.length)];
          point.x += step.dx; point.y += step.dy;
          point.lastDirection = step.name;
          this.recalcEnteredAreas(point);
        }
      },
      onAreaSizeChange() {
        for (let p of this.points) {
          if (p.x>this.MainArea.X) p.x=this.MainArea.X;
          if (p.y>this.MainArea.Y) p.y=this.MainArea.Y;
        }
      }
    }
  });
});
</script>

<style>
.grid-container {
  display: grid;
  grid-gap: 0; /* 移除格子間隙 */
  position: relative;
  width: max-content;
  background-size: cover;
  background-position: center;
}
.grid-cell {
  width: 20px;
  height: 20px;
  box-sizing: border-box;
}
.grid-cell.forbidden {
  background-color: #555 !important;
}
.grid-cell.limited {
  opacity: 0.5;
}
.point {
  position: absolute;
  width: 16px;
  height: 16px;
  border-radius: 50%;
  animation: blink 2s infinite;
}
@@keyframes blink {
  0%, 50%, 100% { opacity: 1; }
  25%, 75% { opacity: 0; }
}
</style>
