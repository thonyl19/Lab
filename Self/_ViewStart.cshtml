@{
  
    string layout = string.Empty;


    //這裡要用某個Key來判斷是否使用Tab而載入不同的Layout
    var url = Request.Path;
    var useTab = Request.Cookies["useTab"];

    layout = "~/Views/Shared/_Layout.cshtml";

    if (useTab != null)
    {
        if (useTab.Value == "" || useTab.Value == null)
        {
            layout = "~/Views/Shared/_Layout.cshtml";
        }
        else
        {
            layout = "~/Views/Shared/_ModalLayout.cshtml";
        }
    }


    //layout = "~/Views/Shared/_Layout.cshtml";
    Layout = layout;
}
