<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <title>Vue.js 2 + Tabulator.js 欄位標題篩選範例 (CDN)</title>
    <link href="https://cdn.jsdelivr.net/npm/tabulator-tables@5.5.4/dist/css/tabulator.min.css" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/vue@2.7.16/dist/vue.min.js"></script>
    <script type="text/javascript" src="https://cdn.jsdelivr.net/npm/tabulator-tables@5.5.4/dist/js/tabulator.min.js"></script>
    <style>
        .tabulator-header-filter {
            width: 100%;
            box-sizing: border-box;
            padding: 5px;
            margin-top: 2px;
            border: 1px solid #d0d0d0;
        }
    </style>
</head>
<body>
    <div id="app">
        <h1>Vue.js 2 + Tabulator.js 欄位標題篩選範例</h1>
        <div id="editable-table"></div>
    </div>

    <script type="text/javascript">
        new Vue({
            el: '#app',
            data: {
                tableData: [
                    { id: 1, name: "小明", age: 25, city: "台北" },
                    { id: 2, name: "小華", age: 30, city: "台中" },
                    { id: 3, name: "小李", age: 22, city: "高雄" },
                    { id: 4, name: "小王", age: 28, city: "台南" },
                ],
                table: null,
            },
            mounted() {
                this.table = new Tabulator("#editable-table", {
                    data: this.tableData,
                    layout: "fitColumns",
                    columns: [
                        { title: "Id", field: "id", width: 100, editable: false, frozen: true },
                        { title: "姓名", field: "name", editor: "input", headerFilter: "input" },
                        { title: "年齡", field: "age", editor: "number", headerFilter: "number" },
                        {
                            title: "城市",
                            field: "city",
                            editor: "select",
                            editorParams: { values: ["台北", "台中", "高雄", "台南", "其他"] },
                            headerFilter: "select",
                            headerFilterParams: { values: ["", "台北", "台中", "高雄", "台南", "其他"] }
                        },
                    ],
                    cellEdited: (cell) => {
                        console.log("編輯後的資料:", this.table.getData());
                        // 在這裡你可以將更新後的資料同步回你的 Vue.js 資料或後端
                        // 例如： this.tableData = this.table.getData();
                    },
                });
            },
        });
    </script>
</body>
</html>