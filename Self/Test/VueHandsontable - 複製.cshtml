@{
    var _url = "https://cdn.jsdelivr.net/npm/@handsontable/vue@15.2.0/dist/vue-handsontable.min.js";
}
<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <title>Vue2 Handsontable Example</title>
    @eBundle.QRender_CSS()
    @eBundle.QRender_JS()
    <script src="https://cdn.jsdelivr.net/npm/handsontable@8.4.2/dist/handsontable.full.min.js"></script>
    <script type="text/javascript" src="@_url"></script>
    <style>
        .hot-container {
            margin: 20px;
        }
    </style>
</head>
<body>
    <div id="app" class="hot-container">
        <h3>Vue2 Handsontable Example</h3>
        <hot-table :settings="hotSettings" :data="tableData"></hot-table>
    </div>

    <script>
        $(document).ready(() => {
            new Vue({
                el: '#app',
                data: {
                    hotSettings: {
                        colHeaders: true,
                        rowHeaders: true,
                        height: 'auto',
                        licenseKey: 'non-commercial-and-evaluation'
                    },
                    tableData: [
                        ['A1', 'B1', 'C1', 'D1'],
                        ['A2', 'B2', 'C2', 'D2'],
                        ['A3', 'B3', 'C3', 'D3']
                    ]
                },

            });
        })
    </script>
</body>
</html> 