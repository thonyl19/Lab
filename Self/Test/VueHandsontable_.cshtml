@{
    var _url = "https://cdn.jsdelivr.net/npm/@handsontable/vue@15.2.0/dist/vue-handsontable.min.js";
}
<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <title>Vue2 Handsontable Example</title>
    @eBundle.QRender_CSS()
    @eBundle.QRender_JS()
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/handsontable@12.4.0/dist/handsontable.full.min.css" />
    <script src="https://cdn.jsdelivr.net/npm/handsontable@12.4.0/dist/handsontable.full.min.js"></script>

    <!-- 引入 vue-handsontable 封裝 -->
    <script src="@_url"></script>

    <style>
        #app {
            margin: 50px;
        }

        .hot-container {
            width: 800px;
            height: 400px;
        }
        .text-blue {
        color: blue !important;
        }
        .text-red {
        color: red !important;
        }
    </style>
</head>
<body>
    <div id="app">
        <el-button @@click="bind_Data">更新</el-button>
        <hot-table class="hot-container" ref="myHotTable"
                   :settings="hotSettings">
        </hot-table>
        {{hotSettings.data}}
    </div>

    <script>
        $(document).ready(() => {
            // 註冊 hot-table 元件
            Vue.component('hot-table', Handsontable.vue.HotTable);

            new Vue({
                el: '#app',
                data() {
                    var _self=this;
                    return {
                        src :[
                            
                            ],
                        hotSettings: {

                            //afterChange : _self.afterChange,
                            "data": [
                                {
                                    "SampleId": "A",
                                    "GTI25102018093218163": null,
                                    "GTI25102018093218164": null
                                },
                                {
                                    "SampleId": "B",
                                    "GTI25102018093218163": null,
                                    "GTI25102018093218164": null
                                },
                                {
                                    "SampleId": "C",
                                    "GTI25102018093218163": null,
                                    "GTI25102018093218164": null
                                },
                                {
                                    "SampleId": "D",
                                    "GTI25102018093218163": null,
                                    "GTI25102018093218164": null
                                },
                                {
                                    "SampleId": "E",
                                    "GTI25102018093218163": null,
                                    "GTI25102018093218164": null
                                },
                                {
                                    "SampleId": "F",
                                    "GTI25102018093218163": null,
                                    "GTI25102018093218164": null
                                },
                                {
                                    "SampleId": "G",
                                    "GTI25102018093218163": null,
                                    "GTI25102018093218164": null
                                },
                                {
                                    "SampleId": "H",
                                    "GTI25102018093218163": null,
                                    "GTI25102018093218164": null
                                },
                                {
                                    "SampleId": "I",
                                    "GTI25102018093218163": null,
                                    "GTI25102018093218164": null
                                },
                                {
                                    "SampleId": "J",
                                    "GTI25102018093218163": null,
                                    "GTI25102018093218164": null
                                }
                            ],
                            "columns": [
                                {
                                    "title": "Sample Id",
                                    "data": "SampleId",
                                    "type": "text",

                                },
                                {
                                    "title": "鑽孔孔徑D",
                                    "data": "GTI25102018093218163",
                                    "type": "numeric",
                                    "source": null
                                },
                                {
                                    "title": "鑽孔孔徑E",
                                    "data": "GTI25102018093218164",
                                    "type": "dropdown",
                                    "source": ["VGE01-立磨3", "VGE02-立磨4", "VGJ01-立磨1", "VGJ02-立磨2", "VGJ03-立磨5", "VGJ04-立磨6"]
                                }
                            ],
                            fillHandle: false,
                            rowHeaders: false,
                            //manualColumnResize: true,
                            // Handsontable 免費版需要加這行
                            licenseKey: 'non-commercial-and-evaluation', 
                             
                            fixedColumnsLeft: 1,        // 左側凍結 1 欄
                            //dropdownMenu: true,
                            contextMenu: true,
                            //預設 tab 移動模式
                            tabMoves: {
                                row: 0,
                                col: 1
                            },
                            //cells:_self.cells,
                            beforeKeyDown: function (event) {
                                if (event.key === 'Tab') {
                                    const selected = this.getSelected();
                                    if (!selected) return;

                                    event.preventDefault(); // 阻止 Handsontable 內建處理，自己控制

                                    const [row, col] = selected[0];
                                    const lastColIndex = this.countCols() - 1;

                                    if (col < lastColIndex) {
                                        // 還沒到最後一欄，正常往右一格
                                        this.selectCell(row, col );
                                    } else {
                                        // 如果已經在最後一欄
                                        const nextRow = row + 1;
                                        if (nextRow < this.countRows()) {
                                            this.selectCell(nextRow, 0); 
                                        }
                                    }
                                }
                            }
                        }
                    };
                },

                mounted() {
                    // 確保在表格渲染後 Vue 會自動處理 el-tooltip 的顯示
                    //this.$nextTick(() => {
                    //    const tooltipElement = document.querySelector('el-tooltip');
                    //    if (tooltipElement) {
                    //        this.$nextTick(() => {
                    //        // 確保 tooltip 正常工作
                    //        });
                    //    }
                    //});
                },
                methods: {
                    bind_Data(){
                        debugger
                        // const _hotInstance = this.$refs.myHotTable.hotInstance
                        // _hotInstance.data = this.src;
                        // _hotInstance.render();
                        this.hotSettings.data = this.src;
                        this.$nextTick(() => {
                            if (this.$refs.myHotTable && this.$refs.myHotTable.hotInstance) {
                                this.$refs.myHotTable.hotInstance.render();
                            }
                        });
                    },
                    cells(row, col) {
                        const cellProperties = {};
                        //const colProp = this.instance.getSettings().columns[col]?.data;
                        const rowData = this.hotSettings.data[row];
                            // this.instance.getSourceDataAtRow(row);
                        //console.log({colProp, rowData,row, col});
                        console.log({rowData,row, col});

                        if (colProp === 'age') {
                            const age = rowData.age;
                            if (age < 20) {
                            cellProperties.className = 'text-blue';
                            } else if (age >= 40) {
                            cellProperties.className = 'text-red';
                            }
                        }
                        return cellProperties;
                    },    
                    afterChange(changes, source){
                        var _self=this;
                        console.log({changes, source});
                        // 只處理使用者編輯時的變動
                        if (source === 'edit' ) {
                            changes.forEach(([row, prop, oldValue, newValue]) => {
                                if (prop === 'age')  _self.updateAgeCell(row, newValue);
                            });
                        }else if (source === 'loadData') {
                            // 處理資料載入的情況
                            // 因為 loadData 會影響所有資料，我們需要遍歷整個資料集
                            const hotInstance = _self.$refs.myHotTable.hotInstance;
                            const data = hotInstance.getSourceData();
                            data.forEach((rowData, rowIndex) => {
                                const age = rowData.age;
                                if (age !== undefined)_self.updateAgeCell(rowIndex, age);
                            });
                            // 由於這是全表變動，在處理完畢後手動觸發一次渲染
                            hotInstance.render();
                        }
                    },
                    // 將格式化邏輯提取為獨立的方法，方便重複使用
                    updateAgeCell(rowIndex, ageValue) {
                        debugger;
                        const hotInstance = this.$refs.myHotTable.hotInstance;
                        const ageColIndex = 2; 
                        if (ageValue < 20) {
                            hotInstance.setCellMeta(rowIndex, ageColIndex, 'className', 'text-blue');
                        } else if (ageValue >= 40) {
                            hotInstance.setCellMeta(rowIndex, ageColIndex, 'className', 'text-red');
                        } else {
                            // 清除之前的樣式
                            hotInstance.setCellMeta(rowIndex, ageColIndex, 'className', '');
                        }
                        hotInstance.render();
                    }
                }
            });
        });
    </script>
</body>
</html>