@using System.Dynamic
@{
	bool isSingleModel = (bool)ViewData["SingleModel"];
	if (true)
	{
		Layout = "~/Views/Shared/_LayoutSingle.cshtml";
	}
    GTI_Test GTest = new GTI_Test(Html, ViewContext.HttpContext);
}
@eBundle.QRender_CSS()
@eBundle.QRender_JS()
<pre>
</pre>
<div id="app">
    <form id="WipForm">
        <div class="panel b">
            <gti-test></gti-test>
            <el-button @@click="Exec">Exec</el-button>

            <gt-form-col label="測試輸入錯誤訊息" v-model="c_ErrMsg"></gt-form-col>

            <gt-err-tag v-model="c_LotGoodQty" sid="cp_usemtlot.GoodQty"> </gt-err-tag>

            <br />
            <gt-err-tag v-model="this.table_list.length==0" msg="必須有選取資料." sid="cp_usemtlot.count">
            </gt-err-tag>
            <gt-err-tag sid="996"></gt-err-tag>

            <el-button @@click="Add">Add</el-button>
            <el-button @@click="fn_Case1()">由父層丟錯誤({{Case1}})</el-button>
            <el-button @@click="fn_Case2()">由父層丟錯誤({{Case2}})</el-button>

            <el-table :data="table_list" data-parsley-table-required
                      data-parsley-error-messag="data-parsley-error-message"
                      data-parsley-required-message="data-parsley-required-message"
                      data-parsley-required="true"
                      style="width: 100%">
                <el-table-column fixed="left" prop="SID" label="remove" width="100px;">
                    <template slot-scope="scope">
                        <el-button size="small" v-on:click="Remove(scope.$index)" type="danger" icon="el-icon-delete" circle></el-button>
                    </template>
                </el-table-column>
                <el-table-column prop="No" label="AccountNo"></el-table-column>
            </el-table>
        </div>
    </form>
</div>
<script>
    Vue.config.devtools = true;

    $(() => {
        var form = $("#WipForm");
        let { v_rootEl, v_ErrGroup } = Vue.prototype.$UT.Mixins;

        Vue.component('gti-test', {
            mixins: [v_rootEl()],
            props: {
 
            },
            template: `
            <span class="gti-test">
                gti-test
                <gt-err-tag 
                    sid="996">
                </gt-err-tag>

                <gt-err-tag v-model="c_996_1"
                    sid="996_1">
                </gt-err-tag>
                {{this.c_ThrowErr}}
            </span>
            `,
            watch: {
                'c_ThrowErr.996'(val) {
                    console.log('c_ThrowErr.A996_1');
                    if (val == null) return;
                    this.$message(val);
                    this.$delete(this.c_ThrowErr, "996");
                }
            },
            computed: {
                c_996_1() {
                    return ""
                    debugger;
                    let { A996_1 } = this.c_ThrowErr;
                    //this.$delete(this.c_ThrowErr, "A996_1");
                    this.SetErrGroup("996_1", A996_1);
                    return A996_1;
                }
            }
        });

        new Vue({
            mixins: [v_ErrGroup(),v_rootEl()],
            el: '#app',
            provide() {
                return {
                    rootEl: this,
                };
            },
            data() {
                return {
                    ErrMsg: '',
                    value: null,
                    set_model: {},
                    ErrGroup: {},
                    table_list: [],
                    Case1: false,
                    Case2:false,
                }
            },
            mounted() {
                this.SetCheckList('cp_usemtlot', this.Test);
            },
            computed: {

                c_ErrMsg: {
                    get() {
                        return this.ErrMsg;
                    },
                    set(val) {
                        this.ErrMsg = val;
                    }
                },
                c_LotGoodQty() {
                    if (this.ErrMsg != '') {
                        this.SetErrGroup('cp_usemtlot.GoodQty', this.ErrMsg)
                    } else {
                        this.SetErrGroup('cp_usemtlot.GoodQty');
                    }
                },
            },
            methods: {
                fn_Case1() {
                    this.Case1 = !this.Case1;
                    var msg = this.Case1 ? "err" : null;
                    this.SetErrGroup("996",msg);
                },
                fn_Case2() {
                    //this.Case2 = !this.Case2;
                    //var msg = this.Case2 ? "err" : null;
                    this.throwErr("996", "err-996");
                },
                Add() {
                    this.table_list.push({ No: Date.now() })
                },
                Remove(index) {
                    this.table_list.splice(index, 1);
                },
                Test() {
                    
                },
                Exec(e) {
                    if (form.parsley().validate()) {
                        //有錯誤 回傳值為 true
                        if (this.chk_ErrGroup()==false)  this.$message('ok');
                    }
                }
            }
        })
    });
</script>
