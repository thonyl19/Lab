@using System.Dynamic
@model BLL.MES.DataViews.LotData
@{
GTI_Test GTest = new GTI_Test
(Html, HttpContext.Current.IsDebuggingEnabled
, ViewContext.HttpContext.Request);
var BaseRoot = @"~/Areas/MES/Views";
var ZZRoot = @"~/Areas/MPI/Views";
	Layout = "~/Views/Shared/_LayoutSingle.cshtml";
    //R:\MPI_Dev\Genesis_MVC\Views\Shared\part\_Mutlselect.cshtml
}
@eBundle.QRender_CSS();
@eBundle.QRender_JS();
@Html.Partial("_pw_test")
@Html.Partial("_Mutlselect_")
@GTest.Test("_LotEDCOffline_MPI",2)
<pre>
</pre>
<div id="app">
    <form id="WipForm">
        @Html.AntiForgeryToken()
        <div class="panel b">
            <el-button-group>
                <el-button type="primary" size="small" v-for="(val,key) in TestGroup" :label="key" :key="key"
                           @@click="val()">{{key}}{{TestGroup_v[key]}}</el-button>
            </el-button-group>
            <el-checkbox v-model="readonly">readonly</el-checkbox>
            <el-checkbox v-model="disabled">disabled</el-checkbox>


            <div class="col-lg-6 col-md-12 adj">
                <gt-form-col :label="i18n.批號" required col_sty="col-lg-12">
                    <input type="text" :placeholder="i18n.PleaseInput" class="form-control has-req" v-model="c_LOT"
                           @@keypress.enter="fnSearchLot(c_LOT)" :disabled="c_lot_disabled" required>
                </gt-form-col>
            </div>
            <pw-test v-model="cfg" label="cfg"></pw-test>
        </div>
    </form>
</div>
<div id="footerCommand">
    <button type="button" class="btn btn-lg btn-labeled btn-success  btn_submit" style="margin:10px 30px;">
        <span class="btn-label">
            <i class="fa fa-play"></i>
        </span>@RES.BLL.Face.Exec
    </button>

</div>
<script>
    Vue.config.devtools = true;
    $(() => {
        Vue.use(Vuex);

        const store = new Vuex.Store({
            state: {
                set_model: {},
                globalvar: {
                    scrapTotal: 0,
                    GoodList: [],
                    ScrapList: [],
                    DefectList: [],
                    isUserTraceEnter: false,
                    UserTrace: {
                        sts: 21
                    }
                },

            },
            getters: {
                getData(state) {
                    return state.globalvar;
                }
            }
        })


        var form = $("#WipForm");
        new Vue({
            el: '#app',
            mixins: [Vue.prototype.$UT.Mixins.v_ErrGroup()],
            store,
            provide() {
                return {
                    rootEl: this,
                };
            },
            data() {
                var _self = this;
                return {
                    eqp: [],
                    src: [],
                    isTest: true,
                    cfg: {
                        enable_tool: true,
                        enable_run_in: false,
                    },
                    readonly: false,
                    oper_info: {},
                    TestGroup_v: {},
                    TestGroup: {
                        注入list_EQP() {
                            //_self.src = test.list_EQP;
                        },
                    },
                    i18n: {
                        料號: 'AAAA'
                    },
                    readonly: false,
                    disabled: false,
                }
            },
            computed: {
                cp() {
                    return this.$refs['cp'];
                },
            },
            mounted() {
                //this.TestGroup.切換Check();
                //this.TestGroup.注入list_EQP();
            },
            methods: {
                Exec(e) {
                    this.$message('ok');
                    if (this.cfg.single_checkout) {
                        e.preventDefault();
                    } else if (form.parsley().validate()) {

                    }
                },
                fnSearchLot(lot = '') {
                    if (!lot) return;

                    var self = this;
                    var url = "@Url.Action(nameof(Genesis.Areas.WIP.Controllers.LotEDCOffLineController.OffLineRecEDC_LotInfo))";
                    var param = { lot };
                    var _ajax = {
                        url,
                        param,
                        automessage: false,
                        success(res) {
                            //debugger
                            if (!res) return;
                            let { Data, Success, Message = '' } = res;
                            //self.fnClear(['LOT']);

                            if (Success) {
                                //debugger
                                let { form = null, ddl_curr_oper_val = '', ddl_curr_oper_src = [], ddl_record_oper_val = '', ddl_record_oper_src = [] } = Data;

                                self.form = form;
                                self.ddl_record_oper.src = ddl_record_oper_src;

                            } else {
                                self.$Alert.Err(Message);
                                console.log(Message);
                            }


                        }
                    };
                    $.submitForm(_ajax);
                },

            }
        });
        @GTest.Test("i.fa.fa-play", 9);
    });
</script>
<style>
    .gti-limits-info-table {
        width: 23rem;
    }
</style>