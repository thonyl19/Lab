@using System.Dynamic
@{
	bool isSingleModel = (bool)ViewData["SingleModel"];
	if (true)
	{
		Layout = "~/Views/Shared/_LayoutSingle.cshtml";
	}
    GTI_Test GTest = new GTI_Test(Html, ViewContext.HttpContext);
}
@eBundle.QRender_CSS()
@eBundle.QRender_JS()
<pre>
</pre>
<div style="margin:1rem;">
  <div id="app"></div>
</div>

<script>
Vue.config.devtools = true;

$(() => {
  new Vue({
    el: '#app',
    template: `
      <el-container style="height: 100vh;">
        <el-header style="height: auto; padding: 20px 0;">
          <h1>場域管理模擬器</h1>
        </el-header>
        <el-main style="padding: 0;">
          <el-row :gutter="20" style="height: 100%;">
            <el-col :span="12" style="height: 100%;">
              <div
                class="main-area"
                :style="mainAreaStyle"
                @@click="handleGridClick($event)"
              >
                <div
                  v-for="y in MainArea.Y"
                  :key="'row-' + y"
                  class="grid-row"
                >
                  <template v-for="x in MainArea.X">
                    <div
                      class="grid-cell"
                      :key="'cell-' + x + '-' + y"
                      :data-x="x"
                      :data-y="MainArea.Y - y + 1"
                    >
                      <div v-if="isForbidden(x, MainArea.Y - y + 1)" class="forbidden-layer"></div>
                      <div
                        v-else
                        v-for="area in getLimitedAreasAt(x, MainArea.Y - y + 1)"
                        :key="area.id"
                        class="limited-layer"
                        :style="{ backgroundColor: hexToRgba(area.color, 0.3) }"
                      ></div>
                      <div
                        v-for="point in getPointsAt(x, MainArea.Y - y + 1)"
                        :key="point.id"
                        class="point"
                        :class="{ 'blink': point.mode === 'auto' || point.isActive }"
                        :style="{ backgroundColor: point.color }"
                      ></div>
                    </div>
                  </template>
                </div>
              </div>
            </el-col>
            <el-col :span="12">
              <div class="settings-area">
                <el-tabs v-model="activeTab">
                  <el-tab-pane label="場域範圍" name="main-area">
                    <el-form label-position="top">
                      <el-form-item label="橫向格數 (X)">
                        <el-input-number v-model="MainArea.X" :min="1" @@change="updateAreaSize"></el-input-number>
                      </el-form-item>
                      <el-form-item label="縱向格數 (Y)">
                        <el-input-number v-model="MainArea.Y" :min="1" @@change="updateAreaSize"></el-input-number>
                      </el-form-item>
                      <el-form-item label="背景圖 URL">
                        <el-input v-model="MainArea.backgroundUrl"></el-input>
                      </el-form-item>
                    </el-form>
                    <p class="el-form-item__label">說明: (1,1) 為最左下角，(X,Y) 為最右上角。</p>
                  </el-tab-pane>

                  <el-tab-pane label="禁入區域" name="restricted-area">
                    <p>目前為禁入設置模式，點擊左側場域的格子即可加入/移除禁入。</p>
                    <el-button @@click="clearAllRestricted">清空全部禁入</el-button>
                  </el-tab-pane>

                  <el-tab-pane label="限制區域" name="limited-areas">
                    <p>點擊左側場域的格子，即對**當前選取的限制區**加入/移除該格。若該格為禁入，則以禁入優先不予設定。</p>
                    <el-button @@click="addLimitedArea">新增限制區</el-button>
                    <el-divider></el-divider>
                    <el-radio-group v-model="selectedLimitedAreaId">
                      <div v-for="area in LimitedAreas" :key="area.id" style="display: flex; align-items: center; margin-bottom: 10px;">
                        <el-radio :label="area.id">{{ area.id }}</el-radio>
                        <span class="color-dot" :style="{ backgroundColor: area.color }"></span>
                        <el-button type="text" style="margin-left: 10px;" @@click.stop="removeLimitedArea(area.id)">移除</el-button>
                      </div>
                    </el-radio-group>
                  </el-tab-pane>

                  <el-tab-pane label="活動點" name="points">
                    <el-button @@click="addPoint">新增活動點</el-button>
                    <el-divider></el-divider>
                    <el-radio-group v-model="activePointId">
                      <div v-for="point in points" :key="point.id" style="margin-bottom: 10px; padding: 10px; border: 1px solid #eee; border-radius: 4px;">
                        <div style="display: flex; align-items: center;">
                          <el-radio :label="point.id">
                            <span class="color-dot" :style="{ backgroundColor: point.color }"></span>
                            {{ point.id }}
                          </el-radio>
                          <el-button type="text" style="margin-left: auto;" @@click.stop="removePoint(point.id)">移除</el-button>
                        </div>
                        <div style="margin-top: 10px;">
                          <el-radio-group v-model="point.mode">
                            <el-radio-button label="manual">手動</el-radio-button>
                            <el-radio-button label="auto">自動</el-radio-button>
                          </el-radio-group>
                        </div>
                        <p>位置: ({{ point.x }}, {{ point.y }})</p>
                        <p>
                          曾進入過的區域:
                          <el-tag
                            v-for="areaId in point.enteredAreas"
                            :key="areaId"
                            size="mini"
                            style="margin-right: 5px;"
                          >{{ areaId }}</el-tag>
                        </p>
                      </div>
                    </el-radio-group>
                  </el-tab-pane>
                </el-tabs>
              </div>
            </el-col>
          </el-row>
        </el-main>
      </el-container>
    `,
    data() {
      return {
        activeTab: 'main-area',
        activePointId: null,
        selectedLimitedAreaId: null,
        MainArea: {
          X: 20,
          Y: 30,
          backgroundUrl: 'https://cdn.pixabay.com/photo/2016/06/17/04/18/containers-1462947_1280.jpg'
        },
        RestrictedArea: {}, // x: { y: true, ... }
        LimitedAreas: [], // [{ id, color, cells: { x: { y: true } } }]
        points: [], // [{ id, x, y, color, isActive, mode, enteredAreas }]
        autoMoveInterval: null,
      };
    },
    computed: {
      mainAreaStyle() {
        const style = {
          gridTemplateColumns: `repeat(${this.MainArea.X}, 1fr)`,
          gridTemplateRows: `repeat(${this.MainArea.Y}, 1fr)`,
        };
        if (this.MainArea.backgroundUrl) {
          style.backgroundImage = `url(${this.MainArea.backgroundUrl})`;
        }
        return style;
      }
    },
    watch: {
      points: {
        handler() {
          this.recalculateAllEnteredAreas();
        },
        deep: true,
      },
      activePointId(newId) {
        this.points.forEach(p => {
          p.isActive = (p.id === newId && p.mode === 'manual');
        });
      },
      'MainArea.X': 'updateAreaSize',
      'MainArea.Y': 'updateAreaSize',
    },
    created() {
      window.addEventListener('keydown', this.handleKeyDown);
      this.startAutoMovement();
    },
    beforeDestroy() {
      window.removeEventListener('keydown', this.handleKeyDown);
      clearInterval(this.autoMoveInterval);
    },
    methods: {
      // --- 資料操作工具函式 ---
      isForbidden(x, y) {
        return this.RestrictedArea[x] && this.RestrictedArea[x][y];
      },
      toggleForbidden(x, y) {
        if (!this.RestrictedArea[x]) {
          this.$set(this.RestrictedArea, x, {});
        }
        if (this.RestrictedArea[x][y]) {
          this.$delete(this.RestrictedArea[x], y);
        } else {
          this.$set(this.RestrictedArea[x], y, true);
        }
        if (Object.keys(this.RestrictedArea[x]).length === 0) {
          this.$delete(this.RestrictedArea, x);
        }
      },
      isInLimitedArea(area, x, y) {
        return area.cells[x] && area.cells[x][y];
      },
      toggleLimitedCell(areaId, x, y) {
        const area = this.LimitedAreas.find(a => a.id === areaId);
        if (!area || this.isForbidden(x, y)) return;
        if (!area.cells[x]) {
          this.$set(area.cells, x, {});
        }
        if (area.cells[x][y]) {
          this.$delete(area.cells[x], y);
        } else {
          this.$set(area.cells[x], y, true);
        }
        if (Object.keys(area.cells[x]).length === 0) {
          this.$delete(area.cells, x);
        }
      },
      getPointsAt(x, y) {
        return this.points.filter(p => p.x === x && p.y === y);
      },
      getLimitedAreasAt(x, y) {
        if (this.isForbidden(x, y)) return [];
        return this.LimitedAreas.filter(area => this.isInLimitedArea(area, x, y));
      },
      hexToRgba(hex, alpha) {
        const r = parseInt(hex.slice(1, 3), 16);
        const g = parseInt(hex.slice(3, 5), 16);
        const b = parseInt(hex.slice(5, 7), 16);
        return `rgba(${r}, ${g}, ${b}, ${alpha})`;
      },
      getRandomColor() {
        const letters = '0123456789ABCDEF';
        let color = '#';
        for (let i = 0; i < 6; i++) {
          color += letters[Math.floor(Math.random() * 16)];
        }
        return color;
      },
      getUniqueId(prefix) {
        return prefix + Math.floor(Math.random() * 1000) + Date.now().toString().slice(-4);
      },
      
      // --- 事件處理與邏輯 ---
      handleGridClick(event) {
        const target = event.target.closest('.grid-cell');
        if (!target) return;
        const x = parseInt(target.dataset.x);
        const y = parseInt(target.dataset.y);
        
        if (this.activeTab === 'restricted-area') {
          this.toggleForbidden(x, y);
        } else if (this.activeTab === 'limited-areas' && this.selectedLimitedAreaId) {
          this.toggleLimitedCell(this.selectedLimitedAreaId, x, y);
        }
      },
      handleKeyDown(event) {
        const activePoint = this.points.find(p => p.isActive);
        if (!activePoint || activePoint.mode !== 'manual') return;

        let newX = activePoint.x;
        let newY = activePoint.y;

        switch (event.key) {
          case 'ArrowUp':
            newY++;
            break;
          case 'ArrowDown':
            newY--;
            break;
          case 'ArrowLeft':
            newX--;
            break;
          case 'ArrowRight':
            newX++;
            break;
        }

        if (this.canMove(newX, newY)) {
          activePoint.x = newX;
          activePoint.y = newY;
          this.recalcEnteredAreas(activePoint);
        }
      },
      canMove(x, y) {
        return x >= 1 && x <= this.MainArea.X &&
               y >= 1 && y <= this.MainArea.Y &&
               !this.isForbidden(x, y);
      },
      
      // --- 活動點管理 ---
      addPoint() {
        const newPoint = {
          id: this.getUniqueId('P'),
          x: 1,
          y: 1,
          color: this.getRandomColor(),
          isActive: false,
          mode: 'manual',
          enteredAreas: [],
          lastDirection: null
        };
        this.points.push(newPoint);
      },
      removePoint(id) {
        this.points = this.points.filter(p => p.id !== id);
        if (this.activePointId === id) {
          this.activePointId = null;
        }
      },
      
      // --- 限制區域管理 ---
      addLimitedArea() {
        const newArea = {
          id: this.getUniqueId('L'),
          color: this.getRandomColor(),
          cells: {}
        };
        this.LimitedAreas.push(newArea);
        this.selectedLimitedAreaId = newArea.id;
      },
      removeLimitedArea(id) {
        this.LimitedAreas = this.LimitedAreas.filter(a => a.id !== id);
        if (this.selectedLimitedAreaId === id) {
          this.selectedLimitedAreaId = null;
        }
        this.recalculateAllEnteredAreas();
      },
      clearAllRestricted() {
        this.RestrictedArea = {};
        this.recalculateAllEnteredAreas();
      },
      
      // --- 尺寸調整與自動移動 ---
      updateAreaSize() {
        this.points.forEach(p => {
          p.x = Math.max(1, Math.min(this.MainArea.X, p.x));
          p.y = Math.max(1, Math.min(this.MainArea.Y, p.y));
        });
      },
      startAutoMovement() {
        if (this.autoMoveInterval) clearInterval(this.autoMoveInterval);
        this.autoMoveInterval = setInterval(() => {
          this.points.filter(p => p.mode === 'auto').forEach(this.nextAutoStep);
        }, 500);
      },
      nextAutoStep(point) {
        const directions = [
          { dx: 0, dy: 1, name: 'up' },
          { dx: 0, dy: -1, name: 'down' },
          { dx: -1, dy: 0, name: 'left' },
          { dx: 1, dy: 0, name: 'right' },
        ];
        
        const availableMoves = directions.filter(dir => {
          const newX = point.x + dir.dx;
          const newY = point.y + dir.dy;
          return this.canMove(newX, newY) &&
                 (!point.lastDirection || point.lastDirection.dx !== -dir.dx || point.lastDirection.dy !== -dir.dy);
        });

        if (availableMoves.length > 0) {
          const randomMove = availableMoves[Math.floor(Math.random() * availableMoves.length)];
          point.x += randomMove.dx;
          point.y += randomMove.dy;
          point.lastDirection = randomMove;
          this.recalcEnteredAreas(point);
        } else {
          point.lastDirection = null;
        }
      },
      
      // --- 區域判定與維護 ---
      recalcEnteredAreas(point) {
        const currentAreas = new Set();
        this.LimitedAreas.forEach(area => {
          if (this.isInLimitedArea(area, point.x, point.y)) {
            currentAreas.add(area.id);
          }
        });
        this.$set(point, 'enteredAreas', [...currentAreas]);
      },
      recalculateAllEnteredAreas() {
        this.points.forEach(this.recalcEnteredAreas);
      }
    }
  });
});
</script>

<style>
body {
  margin: 0;
  font-family: 'Helvetica Neue', Helvetica, 'PingFang SC', 'Hiragino Sans GB', 'Microsoft YaHei', 'Arial', sans-serif;
}
.main-area {
  position: relative;
  width: 100%;
  height: 100%;
  display: grid;
  grid-gap: 0;
  background-size: cover;
  background-position: center;
  border: 1px solid #dcdfe6;
}
.grid-row {
  display: contents;
}
.grid-cell {
  position: relative;
  width: 100%;
  height: 100%;
  border: 1px solid rgba(0, 0, 0, 0.2);
  box-sizing: border-box;
}
.forbidden-layer, .limited-layer, .point {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
}
.forbidden-layer {
  background-color: rgba(0, 0, 0, 0.6);
  z-index: 3;
}
.limited-layer {
  z-index: 2;
}
.point {
  z-index: 4;
  border-radius: 50%;
  animation-duration: 1s;
  animation-timing-function: ease-in-out;
  animation-iteration-count: infinite;
}
.point.blink {
  animation-name: blink;
}
.settings-area {
  padding: 20px;
  background-color: #f9fafc;
  height: 100%;
  overflow-y: auto;
}
.color-dot {
  display: inline-block;
  width: 12px;
  height: 12px;
  border-radius: 50%;
  margin-left: 5px;
  vertical-align: middle;
}
@@keyframes blink {
  0%, 100% {
    opacity: 1;
  }
  50% {
    opacity: 0.3;
  }
}
</style>

